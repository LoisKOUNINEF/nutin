{
  "baseUrl": "https://nutin.org",
  "disallowBots": [],
  "routes": [
    {
      "path": "/",
      "title": {"en": "Nutin website"},
      "description": {"en": "Nutin framework website. Documentation, guides, tutorial, and articles"},
      "ogImage": "/assets/images/og-covers/og-cover-home.jpg"
    },
    {
      "path": "/articles-index",
      "title": {"en": "Nutin articles"},
      "description": {"en": "Articles about topics such as software architecture, engineering decisions and frontend development."},
      "ogImage": "/assets/images/og-covers/og-cover-articles.jpg"
    },
    {
      "path": "/a11y-elements/:page?",
      "outputPath": "/a11y-elements",
      "title": {"en": "A11y Elements"},
      "description": {"en": "Framework-agnostic accessibility Custom Elements: a Light DOM behavior layer, not a themed UI kit."},
      "ogImage": "/assets/images/og-covers/og-cover-home.jpg"
    },
    {
      "path": "/a11y-elements/:page?",
      "outputPath": "/a11y-elements/elements",
      "mockParams": {"page": "elements"},
      "title": {"en": "a11y-elements: elements demo"},
      "description": {"en": "Live demo of every a11y-elements accessibility component: form controls, links, cards, images, and loading states."},
      "ogImage": "/assets/images/og-covers/og-cover-home.jpg"
    },
    {
      "path": "/a11y-elements/:page?",
      "outputPath": "/a11y-elements/overlays",
      "mockParams": {"page": "overlays"},
      "title": {"en": "a11y-elements: overlays demo"},
      "description": {"en": "Live demo of every a11y-elements overlay: modals, drawers, menus, tooltips, notifications, and floating buttons."},
      "ogImage": "/assets/images/og-covers/og-cover-home.jpg"
    }
  ]
}
