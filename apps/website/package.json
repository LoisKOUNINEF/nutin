{
  "name": "website",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "imports": {
    "#root/*.js": "./*.js"
  },
  "scripts": {
    "build": "node tools/builder/builder.js",
    "build:prod": "NODE_ENV=production node tools/builder/builder.js",
    "serve": "npm run build && npm run serve:only",
    "serve:only": "node tools/dev/serve.js",
    "serve:prod": "npm run build:prod && npm run serve:only",
    "dev": "node tools/dev/dev-serve.js",
    "generate": "node tools/generator/generator.js",
    "testin-nutin": "npm run build && node tools/testin-nutin/runner.js",
    "testin-nutin:watch": "npm run build && node tools/testin-nutin/watch-tests.js",
    "testin-nutin:coverage": "npm run build && node tools/testin-nutin/runner.js --coverage",
    "testin-nutin:verbose": "npm run build && node tools/testin-nutin/runner.js --verbose",
    "docker:build": "node tools/docker/scripts/docker-build.js",
    "docker:run": "node tools/docker/scripts/docker-run.js",
    "patch": "npm version patch -m 'CI/CD: Bump version to %s'",
    "minor": "npm version minor -m 'CI/CD: Bump version to %s'",
    "major": "npm version major -m 'CI/CD: Bump version to %s'"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
