{
  "name": "@nutin/cli",
  "version": "2.0.0",
  "description": "The structure of a framework. The freedom of vanilla.",
  "preferGlobal": true,
  "main": "lib/index.mjs",
  "bin": {
    "cli": "./bin/cli.mjs",
    "nutin": "./bin/cli.mjs",
    "create-nutin-app": "./bin/create-app.mjs",
    "nutin-new": "./bin/create-app.mjs",
    "nutin-add": "./bin/add-feature.mjs",
    "nutin-update": "./bin/update-app.mjs"
  },
  "scripts": {
    "patch": "npm version patch -m 'CI/CD: Bump version to %s'",
    "minor": "npm version minor -m 'CI/CD: Bump version to %s'",
    "major": "npm version major -m 'CI/CD: Bump version to %s'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "Nutin",
    "Vanilla",
    "Framework",
    "Freedom",
    "Structure",
    "Ownership"
  ],
  "author": "Loïs Kouninef <loiskouninef@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "commander": "^9.0.0",
    "diff": "^9.0.0",
    "fs-extra": "^11.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^9.0.0",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loiskouninef/nutin.git"
  },
  "bugs": {
    "url": "https://github.com/loiskouninef/nutin/issues"
  },
  "homepage": "www.nutin.org"
}
