@use "sass:map";

$select-config: (
  'gap': 0.25rem,
  'label-font-size': 0.875rem,
  'control-padding-y': 0.5rem,
  'control-padding-x': 1rem,
  'control-font-family': (Arial, sans-serif),
  'control-font-size': 1rem,
  'control-border-radius': 4px,
  'control-transition-duration': 0.2s,
  'label-font-weight': 600,
  'control-border-width': 1px,
  'control-line-height': 1.4,
  'focus-outline-width': 2px,
  'focus-outline-offset': 2px,
  'color-text-muted': var(--text-muted),
  'color-surface': var(--surface),
  'color-text': var(--text),
  'color-border': var(--border),
  'color-border-strong': var(--border-strong),
  'color-primary': var(--primary),
  'color-disabled-bg': var(--disabled-bg),
  'color-disabled-text': var(--disabled-text),
) !default;

.app-select {
  display: flex;
  flex-direction: column;
  gap: map.get($select-config, 'gap');
  width: 100%;
  cursor: pointer;

  &:has(.select__control:disabled) {
    cursor: not-allowed;
  }
}

.select__label {
  font-size: map.get($select-config, 'label-font-size');
  font-weight: map.get($select-config, 'label-font-weight');
  color: map.get($select-config, 'color-text-muted');

  &:empty { display: none; }
}

.select__control {
  width: 100%;
  padding: map.get($select-config, 'control-padding-y') map.get($select-config, 'control-padding-x');
  background-color: map.get($select-config, 'color-surface');
  color: map.get($select-config, 'color-text');
  border: map.get($select-config, 'control-border-width') solid map.get($select-config, 'color-border');
  border-radius: map.get($select-config, 'control-border-radius');
  font-family: map.get($select-config, 'control-font-family');
  font-size: map.get($select-config, 'control-font-size');
  line-height: map.get($select-config, 'control-line-height');
  cursor: inherit;
  transition:
    border-color  map.get($select-config, 'control-transition-duration') ease,
    box-shadow    map.get($select-config, 'control-transition-duration') ease;

  &:hover:not(:disabled) {
    border-color: map.get($select-config, 'color-border-strong');
  }

  &:focus-visible {
    outline: map.get($select-config, 'focus-outline-width') solid map.get($select-config, 'color-primary');
    outline-offset: map.get($select-config, 'focus-outline-offset');
    border-color: map.get($select-config, 'color-primary');
  }

  &:disabled {
    background-color: map.get($select-config, 'color-disabled-bg');
    color: map.get($select-config, 'color-disabled-text');
    border-color: map.get($select-config, 'color-border');
    cursor: not-allowed;
  }

  option {
    background-color: map.get($select-config, 'color-surface');
    color: map.get($select-config, 'color-text');
  }
}
