@use "sass:map";
@use "../../../styles/nutin-config" as config;

$switch-defaults: (
  'gap': 0.5rem,
  'border-radius': 9999px,
  'transition-duration': 0.2s,
  'label-font-size': 1rem,
  'track-width': 2.75rem,
  'track-height': 1.5rem,
  'thumb-size': 1.125rem,
  'disabled-opacity': 0.6,
  'thumb-shadow-offset-y': 1px,
  'thumb-shadow-blur': 3px,
  'thumb-shadow-color': rgba(0 0 0 / 25%),
  'focus-outline-width': 2px,
  'focus-outline-offset': 2px,
  'label-line-height': 1.4,
  'color-border-strong': #9ca3af,
  'color-background': #ffffff,
  'color-primary': #2563eb,
  'color-disabled-bg': #e5e7eb,
  'color-disabled-text': #9ca3af,
  'color-text': #111827,
);

$switch-config: map.deep-merge(
  $switch-defaults,
  map.get(config.$config, 'components', 'switch') or ()
);

$switch-thumb-offset: (map.get($switch-config, 'track-height') - map.get($switch-config, 'thumb-size')) * 0.5;

.app-switch {
  display: inline-flex;
  align-items: center;
  gap: map.get($switch-config, 'gap');
  cursor: pointer;

  &:has(.switch__input:disabled) {
    cursor: not-allowed;
    opacity: map.get($switch-config, 'disabled-opacity');
  }
}

.switch__input {
  appearance: none;
  -webkit-appearance: none;
  position: relative;
  flex-shrink: 0;
  width: map.get($switch-config, 'track-width');
  height: map.get($switch-config, 'track-height');
  border-radius: map.get($switch-config, 'border-radius');
  background-color: map.get($switch-config, 'color-border-strong');
  cursor: inherit;
  transition: background-color map.get($switch-config, 'transition-duration') ease;

  // Sliding thumb
  &::before {
    content: "";
    position: absolute;
    top: $switch-thumb-offset;
    left: $switch-thumb-offset;
    width: map.get($switch-config, 'thumb-size');
    height: map.get($switch-config, 'thumb-size');
    border-radius: 50%;
    background-color: map.get($switch-config, 'color-background');
    box-shadow:
      0
      map.get($switch-config, 'thumb-shadow-offset-y')
      map.get($switch-config, 'thumb-shadow-blur')
      map.get($switch-config, 'thumb-shadow-color');
    transition: transform map.get($switch-config, 'transition-duration') ease;
  }

  &:checked {
    background-color: map.get($switch-config, 'color-primary');

    &::before {
      transform: translateX(map.get($switch-config, 'track-width') - map.get($switch-config, 'thumb-size') - $switch-thumb-offset * 2);
    }
  }

  &:focus-visible {
    outline: map.get($switch-config, 'focus-outline-width') solid map.get($switch-config, 'color-primary');
    outline-offset: map.get($switch-config, 'focus-outline-offset');
  }

  &:disabled {
    background-color: map.get($switch-config, 'color-disabled-bg');
    cursor: not-allowed;

    &::before {
      background-color: map.get($switch-config, 'color-disabled-text');
      box-shadow: none;
    }
  }
}

.switch__label {
  font-size: map.get($switch-config, 'label-font-size');
  color: map.get($switch-config, 'color-text');
  line-height: map.get($switch-config, 'label-line-height');

  &:empty { display: none; }
}
