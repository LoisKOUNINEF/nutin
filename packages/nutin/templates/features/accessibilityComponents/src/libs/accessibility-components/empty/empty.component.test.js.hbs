import { EmptyComponent } from '#root/dist/src/libs/accessibility-components/empty/empty.component.js';

describe('EmptyComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('defaults to isOptional:true, which strips the empty inner div on render', () => {
    component = new EmptyComponent(placeholder);
    component.render();
    expect(component.getElement().querySelector('div')).toBe(null);
  });

  it('keeps the inner div when isOptional is false', () => {
    component = new EmptyComponent(placeholder, { isOptional: false });
    component.render();
    expect(component.getElement().querySelector('div')).toBeDefined();
  });
});
