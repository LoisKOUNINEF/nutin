import { SkeletonComponent } from '#root/dist/src/libs/accessibility-components/skeleton/skeleton.component.js';

describe('SkeletonComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('is aria-hidden with the app-skeleton class by default', () => {
    component = new SkeletonComponent(placeholder);
    component.render();
    expect(component.getElement().getAttribute('aria-hidden')).toBe('true');
    expect(component.getElement().classList.contains('app-skeleton')).toBe(true);
  });

  it('defaults the variant to rect', () => {
    component = new SkeletonComponent(placeholder);
    component.render();
    expect(component.getElement().classList.contains('skeleton--rect')).toBe(true);
  });

  it('applies an explicit variant', () => {
    component = new SkeletonComponent(placeholder, { variant: 'circle' });
    component.render();
    expect(component.getElement().classList.contains('skeleton--circle')).toBe(true);
  });

  it('sets --skeleton-width/--skeleton-height only when given', () => {
    component = new SkeletonComponent(placeholder, { width: '10rem', height: '2rem' });
    component.render();
    expect(component.getElement().style.getPropertyValue('--skeleton-width')).toBe('10rem');
    expect(component.getElement().style.getPropertyValue('--skeleton-height')).toBe('2rem');
  });

  it('renders no .skeleton__line children by default (non-text variant)', () => {
    component = new SkeletonComponent(placeholder);
    component.render();
    expect(component.getElement().querySelectorAll('.skeleton__line').length).toBe(0);
  });

  it('renders no .skeleton__line children for a single-line text variant', () => {
    component = new SkeletonComponent(placeholder, { variant: 'text', lines: 1 });
    component.render();
    expect(component.getElement().classList.contains('skeleton--multiline')).toBe(false);
    expect(component.getElement().querySelectorAll('.skeleton__line').length).toBe(0);
  });

  it('renders N .skeleton__line children and the multiline class for a multi-line text variant', () => {
    component = new SkeletonComponent(placeholder, { variant: 'text', lines: 3 });
    component.render();
    expect(component.getElement().classList.contains('skeleton--multiline')).toBe(true);
    expect(component.getElement().querySelectorAll('.skeleton__line').length).toBe(3);
  });
});
