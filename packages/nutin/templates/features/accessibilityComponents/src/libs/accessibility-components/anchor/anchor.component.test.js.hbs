import { AnchorComponent } from '#root/dist/src/libs/accessibility-components/anchor/anchor.component.js';

describe('AnchorComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('renders a real anchor (via AnchorManager) inside its wrapper element', () => {
    component = new AnchorComponent(placeholder, { href: 'https://example.com', textContent: 'Visit' });
    component.render();
    const anchor = component.getElement().querySelector('a');
    expect(anchor).toBeDefined();
    expect(anchor.getAttribute('href')).toBe('https://example.com');
    expect(anchor.textContent).toBe('Visit');
  });

  it('defaults the wrapper tagName to "div" when config.tagName is not given', () => {
    component = new AnchorComponent(placeholder, { href: '#x' });
    component.render();
    expect(component.getElement().tagName).toBe('DIV');
  });

  it('uses config.tagName for the wrapper when given', () => {
    component = new AnchorComponent(placeholder, { href: '#x', tagName: 'span' });
    component.render();
    expect(component.getElement().tagName).toBe('SPAN');
  });

  it('does not duplicate the anchor across repeated render() calls', () => {
    component = new AnchorComponent(placeholder, { href: '#x', textContent: 'Go' });
    component.render();
    component.render();
    expect(component.getElement().querySelectorAll('a').length).toBe(1);
  });

  it('applies props.className to the wrapper element', () => {
    component = new AnchorComponent(placeholder, { href: '#x' }, { className: 'nav-link' });
    component.render();
    expect(component.getElement().classList.contains('nav-link')).toBe(true);
  });
});
