import { AttributesHelper } from '#root/dist/src/libs/accessibility-components/utils/helpers/attributes.helper.js';

describe('AttributesHelper', () => {
  let el;

  beforeEach(() => {
    el = document.createElement('span');
  });

  it('sets textContent from config.textContent', () => {
    AttributesHelper.setAttributes(el, { textContent: 'hello' });
    expect(el.textContent).toBe('hello');
  });

  it('defaults textContent to an empty string when not provided', () => {
    el.textContent = 'stale';
    AttributesHelper.setAttributes(el, {});
    expect(el.textContent).toBe('');
  });

  it('sets data-i18n only when i18nKey is provided', () => {
    AttributesHelper.setAttributes(el, { i18nKey: 'greeting' });
    expect(el.getAttribute('data-i18n')).toBe('greeting');
  });

  it('does not set data-i18n when i18nKey is absent', () => {
    AttributesHelper.setAttributes(el, {});
    expect(el.hasAttribute('data-i18n')).toBe(false);
  });

  it('sets data-pipe only when pipes is provided', () => {
    AttributesHelper.setAttributes(el, { pipes: 'uppercase' });
    expect(el.getAttribute('data-pipe')).toBe('uppercase');
  });

  it('does not set data-pipe when pipes is absent', () => {
    AttributesHelper.setAttributes(el, {});
    expect(el.hasAttribute('data-pipe')).toBe(false);
  });

  it('sets className only when provided', () => {
    AttributesHelper.setAttributes(el, { className: 'foo bar' });
    expect(el.className).toBe('foo bar');
  });

  it('sets style only when provided', () => {
    AttributesHelper.setAttributes(el, { style: 'color: red;' });
    expect(el.style.cssText).toContain('color: red');
  });

  it('does not touch className/style when neither is provided', () => {
    el.className = 'existing';
    AttributesHelper.setAttributes(el, {});
    expect(el.className).toBe('existing');
  });

  it('sets aria-label only when provided', () => {
    AttributesHelper.setAttributes(el, { ariaLabel: 'Close' });
    expect(el.getAttribute('aria-label')).toBe('Close');
  });

  it('does not set aria-label when absent', () => {
    AttributesHelper.setAttributes(el, {});
    expect(el.hasAttribute('aria-label')).toBe(false);
  });

  it('applies every field together', () => {
    AttributesHelper.setAttributes(el, {
      textContent: 'Click me',
      i18nKey: 'cta',
      pipes: 'uppercase',
      className: 'btn',
      style: 'color: blue;',
      ariaLabel: 'Call to action',
    });
    expect(el.textContent).toBe('Click me');
    expect(el.getAttribute('data-i18n')).toBe('cta');
    expect(el.getAttribute('data-pipe')).toBe('uppercase');
    expect(el.className).toBe('btn');
    expect(el.style.cssText).toContain('color: blue');
    expect(el.getAttribute('aria-label')).toBe('Call to action');
  });
});
