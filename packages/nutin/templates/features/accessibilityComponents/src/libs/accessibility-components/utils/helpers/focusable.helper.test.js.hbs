import { FocusableHelper } from '#root/dist/src/libs/accessibility-components/utils/helpers/focusable.helper.js';

describe('FocusableHelper', () => {
  it('isActionMode is true only for a callback without an href', () => {
    expect(FocusableHelper.isActionMode({ callback: () => {} })).toBe(true);
    expect(FocusableHelper.isActionMode({ callback: () => {}, href: '#x' })).toBe(false);
    expect(FocusableHelper.isActionMode({})).toBe(false);
  });

  it('isLinkMode is true whenever href is present', () => {
    expect(FocusableHelper.isLinkMode({ href: '#x' })).toBe(true);
    expect(FocusableHelper.isLinkMode({})).toBe(false);
  });

  it('resolveAriaLabel prefers ariaLabel, falls back to href, then empty string', () => {
    expect(FocusableHelper.resolveAriaLabel({ ariaLabel: 'Custom', href: '#x' })).toBe('Custom');
    expect(FocusableHelper.resolveAriaLabel({ href: '#x' })).toBe('#x');
    expect(FocusableHelper.resolveAriaLabel({})).toBe('');
  });

  it('resolveAriaLabel appends the new-tab suffix only in link mode with a target', () => {
    expect(FocusableHelper.resolveAriaLabel({ href: '#x', target: '_blank' })).toBe('#x (opens in new tab)');
    expect(FocusableHelper.resolveAriaLabel({ href: '#x' })).toBe('#x');
    expect(FocusableHelper.resolveAriaLabel({ ariaLabel: 'Action', target: '_blank' })).toBe('Action');
  });

  it('applySemantics sets role/tabindex/aria-label in action mode', () => {
    const el = document.createElement('div');
    FocusableHelper.applySemantics(el, { callback: () => {}, ariaLabel: 'Do it' });
    expect(el.getAttribute('role')).toBe('button');
    expect(el.getAttribute('tabindex')).toBe('0');
    expect(el.getAttribute('aria-label')).toBe('Do it');
  });

  it('applySemantics does not set aria-label in action mode when the resolved label is empty', () => {
    const el = document.createElement('div');
    FocusableHelper.applySemantics(el, { callback: () => {} });
    expect(el.hasAttribute('aria-label')).toBe(false);
  });

  it('applySemantics sets href/target/rel/download/aria-label in link mode', () => {
    const el = document.createElement('a');
    FocusableHelper.applySemantics(el, { href: '#section', target: '_blank', download: 'file.pdf' });
    expect(el.getAttribute('href')).toBe('#section');
    expect(el.getAttribute('target')).toBe('_blank');
    expect(el.getAttribute('rel')).toBe('noopener noreferrer');
    expect(el.getAttribute('download')).toBe('file.pdf');
    expect(el.getAttribute('aria-label')).toBe('#section (opens in new tab)');
  });

  it('applySemantics does not set target/rel/download when absent', () => {
    const el = document.createElement('a');
    FocusableHelper.applySemantics(el, { href: '#section' });
    expect(el.hasAttribute('target')).toBe(false);
    expect(el.hasAttribute('rel')).toBe(false);
    expect(el.hasAttribute('download')).toBe(false);
  });

  it('applyEventListeners in action mode binds click and Enter/Space keydown, tracked for cleanup', () => {
    const el = document.createElement('div');
    let callCount = 0;
    const eventListeners = [];

    FocusableHelper.applyEventListeners(el, { callback: () => { callCount++; } }, eventListeners);

    click(el);
    expect(callCount).toBe(1);

    el.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Enter' }));
    expect(callCount).toBe(2);

    el.dispatchEvent(new window.KeyboardEvent('keydown', { key: ' ' }));
    expect(callCount).toBe(3);

    el.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Tab' }));
    expect(callCount).toBe(3);

    expect(eventListeners.length).toBe(2);
  });

  it('applyEventListeners in link mode always binds a Space keydown handler that clicks the element', () => {
    const el = document.createElement('a');
    let clicked = 0;
    el.addEventListener('click', () => clicked++);
    const eventListeners = [];

    FocusableHelper.applyEventListeners(el, { href: '#x' }, eventListeners);

    el.dispatchEvent(new window.KeyboardEvent('keydown', { key: ' ' }));
    expect(clicked).toBe(1);
    expect(eventListeners.length).toBe(1);
  });

  it('applyEventListeners in link mode also binds an optional click callback', () => {
    const el = document.createElement('a');
    let callCount = 0;
    const eventListeners = [];

    FocusableHelper.applyEventListeners(el, { href: '#x', callback: () => { callCount++; } }, eventListeners);

    click(el);
    expect(callCount).toBe(1);
    expect(eventListeners.length).toBe(2);
  });

  it('applyEventListeners in link mode without a callback only binds the space handler', () => {
    const el = document.createElement('a');
    const eventListeners = [];

    FocusableHelper.applyEventListeners(el, { href: '#x' }, eventListeners);

    expect(eventListeners.length).toBe(1);
  });
});
