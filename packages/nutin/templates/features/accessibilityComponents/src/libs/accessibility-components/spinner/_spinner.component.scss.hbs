@use "sass:map";

$spinner-config: (
  'size': 2rem,
  'thickness': 3px,
  'duration': 1s,
  'size-sm': 1rem,
  'thickness-sm': 2px,
  'size-lg': 3rem,
  'thickness-lg': 4px,
  'size-xl': 4rem,
  'thickness-xl': 5px,
  'color-primary': #2563eb,
  'border-radius': 50%,
) !default;

@mixin spin($duration: 1s, $delay: 0s, $direction: normal) {
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  & {
    animation: spin $duration linear $delay infinite;
    animation-direction: $direction;
  }
}

.app-spinner {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  // TO TEST IN MULTIPLE CONTEXTS
  // grid alternative
  // display: inline-grid;
  // place-items: center;
}

.spinner__ring {
  border-radius: map.get($spinner-config, 'border-radius');
  @include spin(map.get($spinner-config, 'duration'));
  width: var(--spinner-size, #{map.get($spinner-config, 'size')});
  height: var(--spinner-size, #{map.get($spinner-config, 'size')});
  animation-duration: var(--spinner-duration, #{map.get($spinner-config, 'duration')});
  border: var(--spinner-thickness, #{map.get($spinner-config, 'thickness')}) solid transparent;
  border-top-color: var(--spinner-color, #{map.get($spinner-config, 'color-primary')});
}

.app-spinner--sm .spinner__ring {
  --spinner-size: #{map.get($spinner-config, 'size-sm')};
  --spinner-thickness: #{map.get($spinner-config, 'thickness-sm')};
}

.app-spinner--lg .spinner__ring {
  --spinner-size: #{map.get($spinner-config, 'size-lg')};
  --spinner-thickness: #{map.get($spinner-config, 'thickness-lg')};
}

.app-spinner--xl .spinner__ring {
  --spinner-size: #{map.get($spinner-config, 'size-xl')};
  --spinner-thickness: #{map.get($spinner-config, 'thickness-xl')};
}
