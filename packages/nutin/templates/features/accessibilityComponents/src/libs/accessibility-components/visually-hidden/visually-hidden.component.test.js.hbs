import { VisuallyHiddenComponent } from '#root/dist/src/libs/accessibility-components/visually-hidden/visually-hidden.component.js';

describe('VisuallyHiddenComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('applies the visually-hidden class to the wrapper', () => {
    component = new VisuallyHiddenComponent(placeholder, {});
    component.render();
    expect(component.getElement().classList.contains('visually-hidden')).toBe(true);
  });

  it('renders the given textContent', () => {
    component = new VisuallyHiddenComponent(placeholder, { textContent: 'Loading, please wait' });
    component.render();
    expect(component.getElement().querySelector('span').textContent).toBe('Loading, please wait');
  });

  it('renders an empty inner span when textContent is not given', () => {
    component = new VisuallyHiddenComponent(placeholder, {});
    component.render();
    expect(component.getElement().querySelector('span').textContent).toBe('');
  });

  it('sets data-i18n only when i18nKey is given', () => {
    component = new VisuallyHiddenComponent(placeholder, { i18nKey: 'loading.label' });
    component.render();
    expect(component.getElement().querySelector('span').getAttribute('data-i18n')).toBe('loading.label');
  });

  it('sets data-pipe only when pipes is given', () => {
    component = new VisuallyHiddenComponent(placeholder, { pipes: 'uppercase' });
    component.render();
    expect(component.getElement().querySelector('span').getAttribute('data-pipe')).toBe('uppercase');
  });

  it('omits data-i18n/data-pipe when neither is given', () => {
    component = new VisuallyHiddenComponent(placeholder, {});
    component.render();
    const span = component.getElement().querySelector('span');
    expect(span.hasAttribute('data-i18n')).toBe(false);
    expect(span.hasAttribute('data-pipe')).toBe(false);
  });
});
