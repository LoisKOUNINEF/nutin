import { AvatarComponent } from '#root/dist/src/libs/accessibility-components/avatar/avatar.component.js';

describe('AvatarComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('renders an <img> with the fallback span when both src and initials are given', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', src: 'ada.png', initials: 'AL' });
    component.render();
    const img = component.getElement().querySelector('img.avatar__img');
    expect(img.getAttribute('src')).toBe('ada.png');
    expect(img.getAttribute('alt')).toBe('Ada');
    expect(component.getElement().querySelector('.avatar__fallback').textContent).toBe('AL');
  });

  it('renders an <img> with no fallback when initials are absent', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', src: 'ada.png' });
    component.render();
    expect(component.getElement().querySelector('img')).toBeDefined();
    expect(component.getElement().querySelector('.avatar__fallback')).toBe(null);
  });

  it('renders only initials, with role=img and aria-label, when there is no src', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada Lovelace', initials: 'AL' });
    component.render();
    expect(component.getElement().querySelector('img')).toBe(null);
    expect(component.getElement().querySelector('.avatar__initials').textContent).toBe('AL');
    expect(component.getElement().getAttribute('role')).toBe('img');
    expect(component.getElement().getAttribute('aria-label')).toBe('Ada Lovelace');
  });

  it('does not set role/aria-label on the wrapper when a src is given', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', src: 'ada.png' });
    component.render();
    expect(component.getElement().hasAttribute('role')).toBe(false);
    expect(component.getElement().hasAttribute('aria-label')).toBe(false);
  });

  it('defaults shape to circle', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', initials: 'AL' });
    component.render();
    expect(component.getElement().classList.contains('app-avatar')).toBe(true);
    expect(component.getElement().classList.contains('avatar--circle')).toBe(true);
  });

  it('applies an explicit square shape', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', initials: 'AL', shape: 'square' });
    component.render();
    expect(component.getElement().classList.contains('avatar--square')).toBe(true);
  });

  it('sets the --avatar-size CSS variable only when size is given', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', initials: 'AL', size: '48px' });
    component.render();
    expect(component.getElement().style.getPropertyValue('--avatar-size')).toBe('48px');
  });

  it('swaps to the fallback and updates ARIA when the image fails to load', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', src: 'broken.png', initials: 'AL' });
    component.render();

    const img = component.getElement().querySelector('img');
    const fallback = component.getElement().querySelector('.avatar__fallback');
    img.dispatchEvent(new window.Event('error'));

    expect(img.style.display).toBe('none');
    expect(component.getElement().getAttribute('role')).toBe('img');
    expect(component.getElement().getAttribute('aria-label')).toBe('Ada');
    expect(fallback.hasAttribute('aria-hidden')).toBe(false);
  });

  it('does not bind an error listener when there is no src or no initials', () => {
    component = new AvatarComponent(placeholder, { alt: 'Ada', initials: 'AL' });
    expect(() => component.render()).not.toThrow();
  });
});
