import { ButtonComponent } from '#root/dist/src/libs/accessibility-components/button/button.component.js';

describe('ButtonComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('renders a button (via ButtonManager) inside the component-buttons container', () => {
    component = new ButtonComponent(placeholder, { callback: () => {}, textContent: 'Save' });
    component.render();
    const container = component.getElement().querySelector('.component-buttons');
    expect(container).toBeDefined();
    const button = container.querySelector('button');
    expect(button.textContent).toBe('Save');
  });

  it('invokes the configured callback when the button is clicked', () => {
    let called = false;
    component = new ButtonComponent(placeholder, { callback: () => { called = true; }, textContent: 'Save' });
    component.render();

    click(component.getElement().querySelector('button'));

    expect(called).toBe(true);
  });
});
