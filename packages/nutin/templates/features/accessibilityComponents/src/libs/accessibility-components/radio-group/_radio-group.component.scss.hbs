@use "sass:map";
@use "../../../styles/nutin-config" as config;

$radio-group-defaults: (
  'legend-font-size': 0.875rem,
  'legend-margin-bottom': 0.5rem,
  'options-gap': 0.5rem,
  'option-gap': 0.5rem,
  'input-transition-duration': 0.2s,
  'label-font-size': 1rem,
  'disabled-opacity': 0.6,
  'input-size': 1.125rem,
  'input-border-width': 2px,
  'checked-inner-ring': 0.2rem,
  'checked-outer-ring': 0.5rem,
  'focus-outline-width': 2px,
  'focus-outline-offset': 2px,
  'label-line-height': 1.4,
  'color-text-muted': #6b7280,
  'color-border-strong': #9ca3af,
  'color-background': #ffffff,
  'color-primary': #2563eb,
  'color-disabled-bg': #e5e7eb,
  'color-border': #d1d5db,
  'color-text': #111827,
);

$radio-group-config: map.deep-merge(
  $radio-group-defaults,
  map.get(config.$config, 'components', 'radio-group') or ()
);

.app-radio-group {
  border: none;
  padding: 0;
  margin: 0;
  min-width: 0; // fieldset min-width override

  &:disabled {
    opacity: map.get($radio-group-config, 'disabled-opacity');
    cursor: not-allowed;
  }
}

.radio-group__legend {
  font-size: map.get($radio-group-config, 'legend-font-size');
  font-weight: 600;
  color: map.get($radio-group-config, 'color-text-muted');
  padding: 0;
  margin-bottom: map.get($radio-group-config, 'legend-margin-bottom');

  &:empty { display: none; }
}

.radio-group__options {
  display: flex;
  flex-direction: column;
  gap: map.get($radio-group-config, 'options-gap');
}

.radio-group__option {
  display: inline-flex;
  align-items: center;
  gap: map.get($radio-group-config, 'option-gap');
  cursor: pointer;

  &:has(.radio__input:disabled) {
    cursor: not-allowed;
    opacity: map.get($radio-group-config, 'disabled-opacity');
  }
}

.radio__input {
  appearance: none;
  -webkit-appearance: none;
  flex-shrink: 0;
  width: map.get($radio-group-config, 'input-size');
  height: map.get($radio-group-config, 'input-size');
  border: map.get($radio-group-config, 'input-border-width') solid map.get($radio-group-config, 'color-border-strong');
  border-radius: 50%;
  background-color: map.get($radio-group-config, 'color-background');
  cursor: inherit;
  transition:
    background-color map.get($radio-group-config, 'input-transition-duration') ease,
    border-color     map.get($radio-group-config, 'input-transition-duration') ease,
    box-shadow       map.get($radio-group-config, 'input-transition-duration') ease;

  &:checked {
    border-color: map.get($radio-group-config, 'color-primary');
    // inner dot via inset box-shadow — adapts to theme automatically
    box-shadow:
      inset 0 0 0 map.get($radio-group-config, 'checked-inner-ring') map.get($radio-group-config, 'color-background'),
      inset 0 0 0 map.get($radio-group-config, 'checked-outer-ring') map.get($radio-group-config, 'color-primary');
  }

  &:focus-visible {
    outline: map.get($radio-group-config, 'focus-outline-width') solid map.get($radio-group-config, 'color-primary');
    outline-offset: map.get($radio-group-config, 'focus-outline-offset');
  }

  &:disabled {
    background-color: map.get($radio-group-config, 'color-disabled-bg');
    border-color: map.get($radio-group-config, 'color-border');
    cursor: not-allowed;

    &:checked {
      box-shadow:
        inset 0 0 0 map.get($radio-group-config, 'checked-inner-ring') map.get($radio-group-config, 'color-background'),
        inset 0 0 0 map.get($radio-group-config, 'checked-outer-ring') map.get($radio-group-config, 'color-border-strong');
    }
  }
}

.radio__label {
  font-size: map.get($radio-group-config, 'label-font-size');
  color: map.get($radio-group-config, 'color-text');
  line-height: map.get($radio-group-config, 'label-line-height');

  &:empty { display: none; }
}
