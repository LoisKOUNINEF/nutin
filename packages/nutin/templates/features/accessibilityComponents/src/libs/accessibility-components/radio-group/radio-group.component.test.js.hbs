import { RadioGroupComponent } from '#root/dist/src/libs/accessibility-components/radio-group/radio-group.component.js';

describe('RadioGroupComponent', () => {
  let placeholder;
  let component;

  const options = [
    { value: 'a', labelText: 'Option A' },
    { value: 'b', labelText: 'Option B', checked: true },
  ];

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('renders a fieldset with the app-radio-group class and one radio input per option', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options });
    component.render();
    expect(component.getElement().classList.contains('app-radio-group')).toBe(true);
    const inputs = component.getElement().querySelectorAll('input[type="radio"]');
    expect(inputs.length).toBe(2);
    expect(inputs[0].name).toBe('plan');
    expect(inputs[0].value).toBe('a');
  });

  it('defaults each option id to `${name}-${index}` when not explicitly given', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options });
    component.render();
    const inputs = component.getElement().querySelectorAll('input[type="radio"]');
    expect(inputs[0].id).toBe('plan-0');
    expect(inputs[1].id).toBe('plan-1');
  });

  it('uses an explicit option id when given', () => {
    component = new RadioGroupComponent(placeholder, {
      name: 'plan', options: [{ value: 'a', id: 'custom-id' }],
    });
    component.render();
    expect(component.getElement().querySelector('input').id).toBe('custom-id');
  });

  it('applies checked/disabled per option, and required to every option when set', () => {
    component = new RadioGroupComponent(placeholder, {
      name: 'plan', required: true,
      options: [{ value: 'a', disabled: true }, { value: 'b', checked: true }],
    });
    component.render();
    const inputs = component.getElement().querySelectorAll('input[type="radio"]');
    expect(inputs[0].disabled).toBe(true);
    expect(inputs[0].checked).toBe(false);
    expect(inputs[1].checked).toBe(true);
    expect(inputs[0].required).toBe(true);
    expect(inputs[1].required).toBe(true);
  });

  it('disables the fieldset itself when config.disabled is set', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options, disabled: true });
    component.render();
    expect(component.getElement().disabled).toBe(true);
  });

  it('sets aria-label on the fieldset when config.ariaLabel is given', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options, ariaLabel: 'Choose a plan' });
    component.render();
    expect(component.getElement().getAttribute('aria-label')).toBe('Choose a plan');
  });

  it('does not set aria-label on the fieldset when config.ariaLabel is not given', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options });
    component.render();
    expect(component.getElement().hasAttribute('aria-label')).toBe(false);
  });

  it('renders a legend when legendText/legendKey is given', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options, legendText: 'Choose a plan' });
    component.render();
    const legend = component.getElement().querySelector('legend');
    expect(legend).toBeDefined();
    expect(legend.textContent).toBe('Choose a plan');
  });

  it('strips the legend entirely when neither legendText nor legendKey is given', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options });
    component.render();
    expect(component.getElement().querySelector('legend')).toBe(null);
  });

  it('getValue returns the checked option value, setValue checks the matching option', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options });
    component.render();
    expect(component.getValue()).toBe('b');

    component.setValue('a');
    expect(component.getValue()).toBe('a');
  });

  it('calls onChange with the value only when a radio becomes checked via a delegated change event', () => {
    let received = null;
    let callCount = 0;
    component = new RadioGroupComponent(placeholder, {
      name: 'plan', options, onChange: (value) => { received = value; callCount++; },
    });
    component.render();
    const [first, second] = component.getElement().querySelectorAll('input[type="radio"]');

    second.checked = true;
    second.dispatchEvent(new window.Event('change', { bubbles: true }));
    expect(received).toBe('b');
    expect(callCount).toBe(1);

    first.checked = false;
    first.dispatchEvent(new window.Event('change', { bubbles: true }));
    expect(callCount).toBe(1);
  });

  it('does not bind a change listener at all when onChange is not a function', () => {
    component = new RadioGroupComponent(placeholder, { name: 'plan', options });
    component.render();
    expect(() => {
      component.getElement().querySelector('input').dispatchEvent(new window.Event('change', { bubbles: true }));
    }).not.toThrow();
  });

  it('stops calling onChange after destroy()', () => {
    let callCount = 0;
    component = new RadioGroupComponent(placeholder, {
      name: 'plan', options, onChange: () => { callCount++; },
    });
    component.render();
    const input = component.getElement().querySelector('input[type="radio"]');

    component.destroy();
    input.checked = true;
    input.dispatchEvent(new window.Event('change', { bubbles: true }));
    expect(callCount).toBe(0);

    component = null;
  });
});
