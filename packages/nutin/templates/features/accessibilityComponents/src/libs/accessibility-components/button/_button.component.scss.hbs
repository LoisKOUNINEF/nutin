@use "sass:map";

$button-config: (
  'color-outline': #2563eb,
) !default;

.component-buttons {
  button {
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid map.get($button-config, 'color-outline');
      outline-offset: 2px;
    }

    &:active {
      opacity: 0.85;
    }

    &:disabled {
      pointer-events: none;
      cursor: not-allowed;
    }
  }
}
