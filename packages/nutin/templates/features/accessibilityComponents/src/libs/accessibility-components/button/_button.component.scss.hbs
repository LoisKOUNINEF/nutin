@use "sass:map";
@use "../../../styles/nutin-config" as config;

$button-defaults: (
  'color-outline': #2563eb,
);

$button-config: map.deep-merge(
  $button-defaults,
  map.get(config.$config, 'components', 'button') or ()
);

.component-buttons {
  button {
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid map.get($button-config, 'color-outline');
      outline-offset: 2px;
    }

    &:active {
      opacity: 0.85;
    }

    &:disabled {
      pointer-events: none;
      cursor: not-allowed;
    }
  }
}
