import { SwitchComponent } from '#root/dist/src/libs/accessibility-components/switch/switch.component.js';

describe('SwitchComponent', () => {
  let placeholder;
  let component;

  beforeEach(() => {
    placeholder = document.createElement('div');
    document.body.appendChild(placeholder);
  });

  afterEach(() => {
    component?.destroy();
    component = null;
    placeholder = null;
  });

  it('renders a checkbox input with role="switch" and the app-switch class', () => {
    component = new SwitchComponent(placeholder, {});
    component.render();
    expect(component.getElement().classList.contains('app-switch')).toBe(true);
    const input = component.getElement().querySelector('input.switch__input');
    expect(input.type).toBe('checkbox');
    expect(input.getAttribute('role')).toBe('switch');
  });

  it('applies id/name/value/ariaLabel/checked/disabled/required attributes when provided', () => {
    component = new SwitchComponent(placeholder, {
      id: 'notify', name: 'notifications', value: 'on', ariaLabel: 'Enable notifications',
      checked: true, disabled: true, required: true,
    });
    component.render();
    const input = component.getElement().querySelector('input');
    expect(input.id).toBe('notify');
    expect(input.name).toBe('notifications');
    expect(input.value).toBe('on');
    expect(input.getAttribute('aria-label')).toBe('Enable notifications');
    expect(input.checked).toBe(true);
    expect(input.disabled).toBe(true);
    expect(input.required).toBe(true);
  });

  it('omits optional attributes when not provided', () => {
    component = new SwitchComponent(placeholder, {});
    component.render();
    const input = component.getElement().querySelector('input');
    expect(input.hasAttribute('id')).toBe(false);
    expect(input.checked).toBe(false);
    expect(input.disabled).toBe(false);
  });

  it('renders a label when given, strips it when absent', () => {
    component = new SwitchComponent(placeholder, { labelText: 'Enable' });
    component.render();
    expect(component.getElement().querySelector('.switch__label')).toBeDefined();
  });

  it('strips the label when neither labelText nor labelKey is given', () => {
    component = new SwitchComponent(placeholder, {});
    component.render();
    expect(component.getElement().querySelector('.switch__label')).toBe(null);
  });

  it('getValue/setValue read and write the checked state', () => {
    component = new SwitchComponent(placeholder, {});
    component.render();
    expect(component.getValue()).toBe(false);
    component.setValue(true);
    expect(component.getValue()).toBe(true);
  });

  it('calls onChange with the new checked state on a real change event, and stops after destroy()', () => {
    let received = null;
    let callCount = 0;
    component = new SwitchComponent(placeholder, { onChange: (checked) => { received = checked; callCount++; } });
    component.render();
    const input = component.getElement().querySelector('input');

    input.checked = true;
    input.dispatchEvent(new window.Event('change'));
    expect(received).toBe(true);
    expect(callCount).toBe(1);

    component.destroy();
    input.dispatchEvent(new window.Event('change'));
    expect(callCount).toBe(1);

    component = null;
  });
});
