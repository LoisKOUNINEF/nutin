@use "sass:map";

$skeleton-config: (
  'border-radius': 4px,
  'text-border-radius': 2px,
  'line-border-radius': 2px,
  'multiline-gap': 0.5rem,
  'pulse-duration': 1.5s,
  'pulse-min-opacity': 0.45,
  'stagger-delay': 0.1s,
  'last-line-width': 70%,
  'circle-default-size': 2.5rem,
  'default-height': 1em,
  'color-surface': var(--surface),
) !default;

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: map.get($skeleton-config, 'pulse-min-opacity'); }
}

.app-skeleton {
  display: block;
  background-color: map.get($skeleton-config, 'color-surface');
  border-radius: map.get($skeleton-config, 'border-radius');
  animation: skeleton-pulse map.get($skeleton-config, 'pulse-duration') ease-in-out infinite;

  &.skeleton--rect {
    width:  var(--skeleton-width, 100%);
    height: var(--skeleton-height, #{map.get($skeleton-config, 'default-height')});
  }

  &.skeleton--circle {
    // height defaults to match width so the shape stays circular
    width:  var(--skeleton-width, #{map.get($skeleton-config, 'circle-default-size')});
    height: var(--skeleton-height, var(--skeleton-width, #{map.get($skeleton-config, 'circle-default-size')}));
    border-radius: 50%;
  }

  &.skeleton--text {
    width:  var(--skeleton-width, 100%);
    height: var(--skeleton-height, #{map.get($skeleton-config, 'default-height')});
    border-radius: map.get($skeleton-config, 'text-border-radius');
  }

  // multiline: the wrapper becomes a flex column; children are the actual lines
  &.skeleton--multiline {
    background: none;
    animation: none;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    gap: map.get($skeleton-config, 'multiline-gap');
  }
}

.skeleton__line {
  display: block;
  height: var(--skeleton-height, #{map.get($skeleton-config, 'default-height')});
  background-color: map.get($skeleton-config, 'color-surface');
  border-radius: map.get($skeleton-config, 'line-border-radius');
  animation: skeleton-pulse map.get($skeleton-config, 'pulse-duration') ease-in-out infinite;

  // Stagger animation slightly per line for a wave feel
  &:nth-child(2) { animation-delay: map.get($skeleton-config, 'stagger-delay') * 1; }
  &:nth-child(3) { animation-delay: map.get($skeleton-config, 'stagger-delay') * 2; }
  &:nth-child(4) { animation-delay: map.get($skeleton-config, 'stagger-delay') * 3; }
  &:nth-child(n+5) { animation-delay: map.get($skeleton-config, 'stagger-delay') * 4; }

  // Last line is shorter — mimics real text paragraphs
  &:last-child {
    width: map.get($skeleton-config, 'last-line-width');
  }
}
