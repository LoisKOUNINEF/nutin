import { ModalOverlay, ModalView } from '#root/dist/src/libs/overlays/modal/modal.js';
import { Overlays } from '#root/dist/src/core/index.js';
// AppPipeRegistry is a shared, process-wide singleton (see pipe-registry.test.js's
// "onDestroy() clears all registered pipes" test earlier in this repo's history,
// which now restores it afterward). Register pipes here too so this file's
// "capitalize" usage doesn't depend on suite execution order.
import { registerPipes } from '#root/dist/src/libs/pipes/pipes.js';
import { completeTransitionGatedDestroy } from '#root/src/libs/overlays/core/helpers/overlay-lifecycle.helper.js';

describe('ModalOverlay', () => {
  let overlay;

  beforeAll(() => {
    registerPipes();
  });

  beforeEach(() => {
    useFakeTimers();
  });

  afterEach(() => {
    document.querySelectorAll('.modal-overlay').forEach(backdrop => {
      const wrapper = backdrop.querySelector('.modal-wrapper');
      if (wrapper) wrapper.dispatchEvent(new window.Event('transitionend'));
      backdrop.remove();
    });
    document.documentElement.classList.remove('no-scroll');
    document.getElementById('app').inert = false;
    overlay = null;
    useRealTimers();
  });

  it('ModalView is an alias for ModalOverlay', () => {
    expect(ModalView).toBe(ModalOverlay);
  });

  it('emits both modalOpened() and overlayOpened("modal") on render', () => {
    const modalOpenedSpy = spyOn(Overlays, 'modalOpened');
    const overlayOpenedSpy = spyOn(Overlays, 'overlayOpened');

    overlay = new ModalOverlay({ template: '<p>x</p>' });
    overlay.open();

    expect(modalOpenedSpy.callCount).toBe(1);
    expect(overlayOpenedSpy.lastCall).toEqual(['modal']);

    modalOpenedSpy.restore();
    overlayOpenedSpy.restore();
  });

  it('emits both modalClosed() and overlayClosed("modal") plus onClose, only after the transitionend-gated destroy completes', () => {
    const modalClosedSpy = spyOn(Overlays, 'modalClosed');
    const overlayClosedSpy = spyOn(Overlays, 'overlayClosed');
    let closedCb = false;

    overlay = new ModalOverlay({ template: '<p>x</p>', onClose: () => { closedCb = true; } });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.modal-wrapper');

    overlay.close();
    expect(modalClosedSpy.callCount).toBe(0);
    expect(closedCb).toBe(false);

    completeTransitionGatedDestroy(wrapper);
    expect(modalClosedSpy.callCount).toBe(1);
    expect(overlayClosedSpy.lastCall).toEqual(['modal']);
    expect(closedCb).toBe(true);

    modalClosedSpy.restore();
    overlayClosedSpy.restore();
  });

  it('sets document.title from viewName (via the "capitalize" pipe) at construction time, before render()', () => {
    document.title = 'Original Title';

    overlay = new ModalOverlay({ template: '<p>x</p>', viewName: 'settings' });

    expect(document.title).toBe('Settings');
  });

  it('restores the exact prior document.title on destroy', () => {
    document.title = 'Original Title';
    overlay = new ModalOverlay({ template: '<p>x</p>', viewName: 'settings' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.modal-wrapper');

    overlay.close();
    completeTransitionGatedDestroy(wrapper);

    expect(document.title).toBe('Original Title');
  });

  it('leaves document.title untouched entirely when viewName is omitted', () => {
    document.title = 'Untouched Title';
    overlay = new ModalOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.modal-wrapper');

    expect(document.title).toBe('Untouched Title');

    overlay.close();
    completeTransitionGatedDestroy(wrapper);
    expect(document.title).toBe('Untouched Title');
  });

  it('adds modal-wrapper--fullscreen only when fullscreen:true (default false)', () => {
    overlay = new ModalOverlay({ template: '<p>x</p>' });
    let backdrop = overlay.open();
    expect(backdrop.querySelector('.modal-wrapper').classList.contains('modal-wrapper--fullscreen')).toBe(false);
    overlay.close();
    completeTransitionGatedDestroy(backdrop.querySelector('.modal-wrapper'));

    overlay = new ModalOverlay({ template: '<p>x</p>', fullscreen: true });
    backdrop = overlay.open();
    expect(backdrop.querySelector('.modal-wrapper').classList.contains('modal-wrapper--fullscreen')).toBe(true);
  });

  it('derives dialogLabel from viewName, feeding ModalOverlayRuntime\'s auto-label behavior', () => {
    overlay = new ModalOverlay({ template: '<p>no heading</p>', viewName: 'settings' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.modal-wrapper');

    expect(wrapper.getAttribute('aria-labelledby')).toBe('settings-label');
  });
});
