import { ContextMenuOverlay } from '#root/dist/src/libs/overlays/context-menu/context-menu.js';
import { completeTransitionGatedDestroy } from '#root/src/libs/overlays/core/helpers/overlay-lifecycle.helper.js';

describe('ContextMenuOverlay', () => {
  let trigger;
  let overlay;

  const items = [{ label: 'One' }, { label: 'Two' }];

  beforeEach(() => {
    trigger = document.createElement('div');
    document.body.appendChild(trigger);
    useFakeTimers();
  });

  afterEach(() => {
    overlay?.dispose?.();
    document.querySelectorAll('.anchored-overlay-wrapper').forEach(el => {
      el.dispatchEvent(new window.Event('transitionend'));
      el.remove();
    });
    trigger.remove();
    trigger = null;
    overlay = null;
    useRealTimers();
  });

  it('contextmenu on the trigger prevents the default menu, anchors at the click point, and renders directly', () => {
    overlay = new ContextMenuOverlay({ trigger, items });
    const event = new window.MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: 42, clientY: 84 });

    trigger.dispatchEvent(event);

    expect(event.defaultPrevented).toBe(true);
    expect(document.querySelector('.context-menu-wrapper')).toBeDefined();
  });

  it('repeated contextmenu events re-render at the new point, leaving only one wrapper', () => {
    overlay = new ContextMenuOverlay({ trigger, items });

    trigger.dispatchEvent(new window.MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: 10, clientY: 10 }));
    trigger.dispatchEvent(new window.MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: 50, clientY: 50 }));

    expect(document.querySelectorAll('.context-menu-wrapper').length).toBe(1);
  });

  it('renders with the context-menu-wrapper/context-menu-content classes', () => {
    overlay = new ContextMenuOverlay({ trigger, items });
    trigger.dispatchEvent(new window.MouseEvent('contextmenu', { bubbles: true, cancelable: true }));

    const wrapper = document.querySelector('.context-menu-wrapper');
    expect(wrapper.classList.contains('context-menu-wrapper')).toBe(true);
    expect(overlay.getElement().classList.contains('context-menu-content')).toBe(true);
  });

  it('dispose() removes the contextmenu listener and closes the menu', () => {
    overlay = new ContextMenuOverlay({ trigger, items });
    trigger.dispatchEvent(new window.MouseEvent('contextmenu', { bubbles: true, cancelable: true }));
    const wrapper = document.querySelector('.context-menu-wrapper');

    overlay.dispose();
    expect(wrapper.classList.contains('show')).toBe(false);
    completeTransitionGatedDestroy(wrapper);

    trigger.dispatchEvent(new window.MouseEvent('contextmenu', { bubbles: true, cancelable: true }));
    expect(document.querySelectorAll('.context-menu-wrapper').length).toBe(0);
  });
});
