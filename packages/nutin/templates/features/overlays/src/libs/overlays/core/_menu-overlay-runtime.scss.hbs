@use "sass:map";
@use "../../../styles/nutin-config" as config;

$menu-item-defaults: (
  'padding': 0.5rem 1rem,
  'disabled-opacity': 0.5,
  'color-text': #111827,
  'color-secondary-hover': #4b5563,
  'color-background': #ffffff,
);

$menu-item-config: map.deep-merge(
  $menu-item-defaults,
  map.get(config.$config, 'components', 'menu-item') or ()
);

.menu-item {
  padding: map.get($menu-item-config, 'padding');
  cursor: pointer;
  color: map.get($menu-item-config, 'color-text');
  outline: none;

  &:hover,
  &:focus-visible {
    background-color: map.get($menu-item-config, 'color-secondary-hover');
    color: map.get($menu-item-config, 'color-background');
  }

  &.menu-item--disabled {
    cursor: not-allowed;
    opacity: map.get($menu-item-config, 'disabled-opacity');

    &:hover {
      background-color: transparent;
      color: map.get($menu-item-config, 'color-text');
    }
  }
}
