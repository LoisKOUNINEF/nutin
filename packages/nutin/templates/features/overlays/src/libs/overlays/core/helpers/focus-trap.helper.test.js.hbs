import { FocusTrapHelper } from '#root/dist/src/libs/overlays/core/helpers/focus-trap.helper.js';

describe('FocusTrapHelper', () => {
  let container;
  let trap;

  beforeEach(() => {
    container = document.createElement('div');
    document.body.appendChild(container);
  });

  afterEach(() => {
    trap?.deactivate();
    trap = null;
    container.remove();
    container = null;
    document.getElementById('app').inert = false;
  });

  it('activate() focuses the first focusable child and sets isActive', () => {
    container.innerHTML = '<button id="a">A</button><button id="b">B</button>';
    trap = new FocusTrapHelper({ container });

    trap.activate();

    expect(document.activeElement).toBe(container.querySelector('#a'));
    expect(trap.getIsActive()).toBe(true);
  });

  it('activate() with no focusable children sets tabindex=-1 on the container and focuses it', () => {
    container.innerHTML = '<span>no focusables</span>';
    trap = new FocusTrapHelper({ container });

    trap.activate();

    expect(container.getAttribute('tabindex')).toBe('-1');
    expect(document.activeElement).toBe(container);
  });

  it('activate() is idempotent: a second call does not re-save previousActiveElement', () => {
    const outside = document.createElement('button');
    document.body.appendChild(outside);
    outside.focus();

    container.innerHTML = '<button id="a">A</button>';
    trap = new FocusTrapHelper({ container });

    trap.activate();
    container.querySelector('#a').focus();
    trap.activate();
    trap.deactivate();

    expect(document.activeElement).toBe(outside);
    outside.remove();
  });

  it('sets #app.inert = true on activate(), false on deactivate()', () => {
    container.innerHTML = '<button>A</button>';
    trap = new FocusTrapHelper({ container });
    const app = document.getElementById('app');

    trap.activate();
    expect(app.inert).toBe(true);

    trap.deactivate();
    expect(app.inert).toBe(false);
  });

  it('Tab from the last focusable wraps to the first; Shift+Tab from the first wraps to the last', () => {
    container.innerHTML = '<button id="a">A</button><button id="b">B</button>';
    trap = new FocusTrapHelper({ container });
    const a = container.querySelector('#a');
    const b = container.querySelector('#b');

    trap.activate();

    b.focus();
    const tabEvent = new window.KeyboardEvent('keydown', { key: 'Tab', bubbles: true, cancelable: true });
    container.dispatchEvent(tabEvent);
    expect(tabEvent.defaultPrevented).toBe(true);
    expect(document.activeElement).toBe(a);

    a.focus();
    const shiftTabEvent = new window.KeyboardEvent('keydown', { key: 'Tab', shiftKey: true, bubbles: true, cancelable: true });
    container.dispatchEvent(shiftTabEvent);
    expect(shiftTabEvent.defaultPrevented).toBe(true);
    expect(document.activeElement).toBe(b);
  });

  it('Escape (default escapeDeactivates:true) calls preventDefault() and onDeactivate()', () => {
    let deactivated = false;
    container.innerHTML = '<button>A</button>';
    trap = new FocusTrapHelper({ container, options: { onDeactivate: () => { deactivated = true; } } });
    trap.activate();

    const escEvent = new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true });
    container.dispatchEvent(escEvent);

    expect(escEvent.defaultPrevented).toBe(true);
    expect(deactivated).toBe(true);
  });

  it('Escape does nothing when escapeDeactivates:false', () => {
    let deactivated = false;
    container.innerHTML = '<button>A</button>';
    trap = new FocusTrapHelper({ container, options: { escapeDeactivates: false, onDeactivate: () => { deactivated = true; } } });
    trap.activate();

    const escEvent = new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true });
    container.dispatchEvent(escEvent);

    expect(escEvent.defaultPrevented).toBe(false);
    expect(deactivated).toBe(false);
  });

  it('deactivate() strips tabindex="-1" even if it was already present before activate() (observed behavior)', () => {
    container.setAttribute('tabindex', '-1');
    container.innerHTML = '<span>no focusables</span>';
    trap = new FocusTrapHelper({ container });

    trap.activate();
    trap.deactivate();

    expect(container.hasAttribute('tabindex')).toBe(false);
  });

  it('restores focus to the previously active element when returnFocusOnDeactivate (default true)', () => {
    const outside = document.createElement('button');
    document.body.appendChild(outside);
    outside.focus();

    container.innerHTML = '<button id="a">A</button>';
    trap = new FocusTrapHelper({ container });
    trap.activate();
    trap.deactivate();

    expect(document.activeElement).toBe(outside);
    outside.remove();
  });

  it('does not restore focus when returnFocusOnDeactivate:false', () => {
    const outside = document.createElement('button');
    document.body.appendChild(outside);
    outside.focus();

    container.innerHTML = '<button id="a">A</button>';
    trap = new FocusTrapHelper({ container, options: { returnFocusOnDeactivate: false } });
    trap.activate();
    trap.deactivate();

    expect(document.activeElement).not.toBe(outside);
    outside.remove();
  });

  it('deactivate() is a no-op if the trap was never activated', () => {
    container.innerHTML = '<button>A</button>';
    trap = new FocusTrapHelper({ container });

    expect(() => trap.deactivate()).not.toThrow();
    expect(trap.getIsActive()).toBe(false);
  });

  it('updateFocusableElements() no-ops when inactive; when active, re-queries so Tab-wrap targets newly added elements', () => {
    container.innerHTML = '<button id="a">A</button><button id="b">B</button>';
    trap = new FocusTrapHelper({ container });

    expect(() => trap.updateFocusableElements()).not.toThrow();

    trap.activate();
    const c = document.createElement('button');
    c.id = 'c';
    c.textContent = 'C';
    container.appendChild(c);
    trap.updateFocusableElements();

    container.querySelector('#a').focus();
    const shiftTabEvent = new window.KeyboardEvent('keydown', { key: 'Tab', shiftKey: true, bubbles: true, cancelable: true });
    container.dispatchEvent(shiftTabEvent);

    expect(document.activeElement).toBe(c);
  });
});
