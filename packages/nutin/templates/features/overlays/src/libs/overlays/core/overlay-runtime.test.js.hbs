import { BlockingLoaderOverlay } from '#root/dist/src/libs/overlays/blocking-loader/blocking-loader.js';

describe('OverlayRuntime (via BlockingLoaderOverlay)', () => {
  let overlay;

  afterEach(() => {
    overlay?.close?.();
    overlay = null;
    document.querySelectorAll('.blocking-loader-overlay').forEach(el => el.remove());
    document.documentElement.classList.remove('no-scroll');
  });

  it('appends its element directly into document.body at construction time, before render() is ever called', () => {
    overlay = new BlockingLoaderOverlay();
    expect(document.body.contains(overlay.getElement())).toBe(true);
  });

  it('forces mountTarget to "body" regardless of what is passed in', () => {
    const bogusTarget = document.createElement('div');
    document.body.appendChild(bogusTarget);

    overlay = new BlockingLoaderOverlay({ mountTarget: bogusTarget });

    expect(document.body.contains(overlay.getElement())).toBe(true);
    expect(bogusTarget.contains(overlay.getElement())).toBe(false);

    bogusTarget.remove();
  });

  it('open() calls render() and returns the rendered element', () => {
    overlay = new BlockingLoaderOverlay({ message: 'Loading data' });
    const result = overlay.open();

    expect(result).toBe(overlay.getElement());
    expect(overlay.getElement().querySelector('.blocking-loader-overlay__message').textContent).toContain('Loading data');
  });

  it('close() calls destroy() synchronously, with no transition gating at this layer', () => {
    overlay = new BlockingLoaderOverlay();
    overlay.open();
    const el = overlay.getElement();

    overlay.close();

    expect(document.body.contains(el)).toBe(false);
  });

  it('mounts once at construction; close() detaches the element and a later render() does not remount it', () => {
    overlay = new BlockingLoaderOverlay();
    overlay.open();
    overlay.close();

    const result = overlay.open();

    expect(document.body.contains(result)).toBe(false);
  });
});
