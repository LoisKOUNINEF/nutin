import { TooltipOverlay } from '#root/dist/src/libs/overlays/tooltip/tooltip.js';
import { completeTransitionGatedDestroy } from '#root/src/libs/overlays/core/helpers/overlay-lifecycle.helper.js';

describe('TooltipOverlay', () => {
  let anchor;
  let tooltip;

  beforeEach(() => {
    anchor = document.createElement('button');
    document.body.appendChild(anchor);
    useFakeTimers();
  });

  afterEach(() => {
    tooltip?.dispose?.();
    document.querySelectorAll('.tooltip-wrapper').forEach(el => {
      el.dispatchEvent(new window.Event('transitionend'));
      el.remove();
    });
    anchor.remove();
    anchor = null;
    tooltip = null;
    useRealTimers();
  });

  it('does not render synchronously on mouseenter; renders only after showDelay elapses (default 300ms)', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });

    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    expect(document.querySelector('.tooltip-wrapper')).toBe(null);

    advanceTimersByTime(299);
    expect(document.querySelector('.tooltip-wrapper')).toBe(null);

    advanceTimersByTime(1);
    expect(document.querySelector('.tooltip-wrapper')).toBeDefined();
  });

  it('focus also schedules show, same as mouseenter', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });

    anchor.dispatchEvent(new window.FocusEvent('focus'));
    advanceTimersByTime(300);

    expect(document.querySelector('.tooltip-wrapper')).toBeDefined();
  });

  it('schedules hide on mouseleave (default hideDelay 100ms), gated on transitionend for actual removal', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });
    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(300);
    const wrapper = document.querySelector('.tooltip-wrapper');

    anchor.dispatchEvent(new window.MouseEvent('mouseleave'));
    advanceTimersByTime(99);
    expect(document.body.contains(wrapper)).toBe(true);

    advanceTimersByTime(1);
    expect(document.body.contains(wrapper)).toBe(true);
    expect(wrapper.classList.contains('show')).toBe(false);

    completeTransitionGatedDestroy(wrapper);
    expect(document.body.contains(wrapper)).toBe(false);
  });

  it('blur also schedules hide, same as mouseleave', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });
    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(300);
    const wrapper = document.querySelector('.tooltip-wrapper');

    anchor.dispatchEvent(new window.FocusEvent('blur'));
    advanceTimersByTime(100);

    expect(wrapper.classList.contains('show')).toBe(false);
    completeTransitionGatedDestroy(wrapper);
  });

  it('rapid mouseenter -> mouseleave before showDelay elapses cancels the pending show, so it never renders', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });

    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(150);
    anchor.dispatchEvent(new window.MouseEvent('mouseleave'));
    advanceTimersByTime(150);

    expect(document.querySelector('.tooltip-wrapper')).toBe(null);
  });

  it('role="tooltip" and tooltip-wrapper/tooltip-content classes are present once shown', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip content</p>' });
    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(300);

    const wrapper = document.querySelector('.tooltip-wrapper');
    expect(wrapper.getAttribute('role')).toBe('tooltip');
    expect(tooltip.getElement().classList.contains('tooltip-content')).toBe(true);
  });

  it('dispose() removes all 4 anchor listeners, so events after it schedule nothing', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });
    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(300);
    const wrapper = document.querySelector('.tooltip-wrapper');

    tooltip.dispose();
    expect(wrapper.classList.contains('show')).toBe(false);
    completeTransitionGatedDestroy(wrapper);

    const countBefore = getTimerCount();
    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    anchor.dispatchEvent(new window.FocusEvent('focus'));
    anchor.dispatchEvent(new window.MouseEvent('mouseleave'));
    anchor.dispatchEvent(new window.FocusEvent('blur'));

    expect(getTimerCount()).toBe(countBefore);
  });

  it('a bare close() (without dispose()) leaves the anchor listeners intact', () => {
    tooltip = new TooltipOverlay({ anchor, template: '<p>tip</p>' });
    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(300);
    const wrapper = document.querySelector('.tooltip-wrapper');
    tooltip.close();
    completeTransitionGatedDestroy(wrapper);

    anchor.dispatchEvent(new window.MouseEvent('mouseenter'));
    advanceTimersByTime(300);

    expect(document.querySelector('.tooltip-wrapper')).toBeDefined();
  });
});
