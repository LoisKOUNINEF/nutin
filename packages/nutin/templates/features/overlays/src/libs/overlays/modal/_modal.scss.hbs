@use "sass:map";
@use "../core/overlay-variables" as *;
@use "../../../styles/nutin-config" as config;

// modal overlay config
$modal-defaults: (
  'z-index': map.get($overlay-z-index, modal),
  'transition-duration': 0.3s,
  'border-radius': 1rem,
  'initial-scale': 0.95,
  'close-button-size': 1.5rem,
  'footer-gap': 1rem,
  'footer-margin-top': 1.5rem,
  'footer-button-padding': 0.5rem 1rem,
  'shadow-offset-y': 2px,
  'shadow-blur': 2px,
  'shadow-fade': 80%,
  'fullscreen-width': 100vw,
  'fullscreen-height': 100vh,
  'fullscreen-border-radius': 0,
  'color-overlay': rgba(0, 0, 0, 0.5),
  'color-background': #ffffff,
  'color-text': #111827,
  'color-secondary': #6b7280,
  'color-secondary-hover': #4b5563,
);

$modal-config: map.deep-merge(
  $modal-defaults,
  map.get(config.$config, 'components', 'modal') or ()
);

.modal-overlay {
  z-index: map.get($modal-config, 'z-index');
  position: fixed;
  inset: 0;
  backdrop-filter: blur(5px);
  background-color: map.get($modal-config, 'color-overlay');
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;

  &.show {
    animation: modal-show map.get($modal-config, 'transition-duration') ease forwards;
  }
}

.modal-wrapper {
  overflow-y: auto;
  position: relative;
  overscroll-behavior: none;
  background: map.get($modal-config, 'color-background');
  color: map.get($modal-config, 'color-text');
  box-shadow:
    0
    map.get($modal-config, 'shadow-offset-y')
    map.get($modal-config, 'shadow-blur')
    color-mix(in srgb, map.get($modal-config, 'color-text'), transparent map.get($modal-config, 'shadow-fade'));
  border-radius: map.get($modal-config, 'border-radius');
  width: 100%;
  height: 100%;
  transform: scale(map.get($modal-config, 'initial-scale'));
  opacity: 0;
  transition:
    opacity map.get($modal-config, 'transition-duration') ease,
    transform map.get($modal-config, 'transition-duration') ease;
  -moz-transition:
    opacity map.get($modal-config, 'transition-duration') ease,
    -moz-transform map.get($modal-config, 'transition-duration') ease;
  -webkit-transition:
    opacity map.get($modal-config, 'transition-duration') ease,
    -webkit-transform map.get($modal-config, 'transition-duration') ease;
  -o-transition:
    opacity map.get($modal-config, 'transition-duration') ease,
    -o-transform map.get($modal-config, 'transition-duration') ease;

  &.show {
    transform: scale(1);
    -moz-transform: scale(1);
    -webkit-transform: scale(1);
    -o-transform: scale(1);
    opacity: 1;
  }
}

.modal-content {
  position: relative;
  height: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
}

.modal-wrapper--fullscreen {
  width: map.get($modal-config, 'fullscreen-width');
  height: map.get($modal-config, 'fullscreen-height');
  border-radius: map.get($modal-config, 'fullscreen-border-radius');
  box-shadow: none;
}

.modal-close-button {
  position: absolute;
  z-index: 2;
  top: 0.5rem;
  right: 0.75rem;
  background: none;
  border: none;
  font-size: map.get($modal-config, 'close-button-size');
  cursor: pointer;
  padding: 0 1rem;
  color: map.get($modal-config, 'color-text');

  &:focus:not(:focus-visible) {
    outline: none;
  }

  &:focus-visible {
    outline: 2px solid map.get($modal-config, 'color-secondary');
  }
}

.modal-buttons {
  display: flex;
  justify-content: flex-end;
  gap: map.get($modal-config, 'footer-gap');
  margin-top: map.get($modal-config, 'footer-margin-top');
}

.modal-buttons button {
  background-color: inherit;
  transition: ease-in-out map.get($modal-config, 'transition-duration');
  padding: map.get($modal-config, 'footer-button-padding');
  font-size: 1rem;
  cursor: pointer;

  &:hover {
    background-color: map.get($modal-config, 'color-secondary-hover');
    color: map.get($modal-config, 'color-background');
  }
}
