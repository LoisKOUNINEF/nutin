import { PopoverOverlay } from '#root/dist/src/libs/overlays/popover/popover.js';
import { flushShow, flushOutsideClickBind, completeTransitionGatedDestroy } from '#root/src/libs/overlays/core/helpers/overlay-lifecycle.helper.js';

describe('AnchoredOverlayRuntime (via PopoverOverlay)', () => {
  let anchor;
  let overlay;

  beforeEach(() => {
    anchor = document.createElement('button');
    document.body.appendChild(anchor);
    useFakeTimers();
  });

  afterEach(() => {
    document.querySelectorAll('.anchored-overlay-wrapper').forEach(el => {
      el.dispatchEvent(new window.Event('transitionend'));
      el.remove();
    });
    anchor.remove();
    anchor = null;
    overlay = null;
    useRealTimers();
  });

  it('render()/open() reparents content into a wrapper appended to document.body', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>content</p>' });
    const wrapper = overlay.open();

    expect(wrapper.classList.contains('anchored-overlay-wrapper')).toBe(true);
    expect(wrapper.classList.contains('popover-wrapper')).toBe(true);
    expect(document.body.contains(wrapper)).toBe(true);
    // PopoverOverlay's getContentClass() override returns only 'popover-content',
    // it doesn't chain to the AnchoredOverlayRuntime default via super().
    expect(overlay.getElement().classList.contains('popover-content')).toBe(true);
    expect(wrapper.contains(overlay.getElement())).toBe(true);
  });

  it('does not add the "show" class synchronously; only after the rAF flush', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();

    expect(wrapper.classList.contains('show')).toBe(false);
    flushShow();
    expect(wrapper.classList.contains('show')).toBe(true);
  });

  it('removes the previous wrapper synchronously when render() is called again while already open', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    overlay.render();

    expect(document.querySelectorAll('.anchored-overlay-wrapper').length).toBe(1);
  });

  it('does not close on a click that happens before the deferred outside-click bind fires', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    const closeSpy = spyOn(overlay, 'close');

    document.body.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));

    expect(closeSpy.callCount).toBe(0);
    closeSpy.restore();
  });

  it('closes on an outside click once the deferred bind has fired', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    flushOutsideClickBind();
    const closeSpy = spyOn(overlay, 'close');

    document.body.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));

    expect(closeSpy.callCount).toBe(1);
    closeSpy.restore();
  });

  it('does not close on a click inside the wrapper', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p id="inner">x</p>' });
    const wrapper = overlay.open();
    flushOutsideClickBind();
    const closeSpy = spyOn(overlay, 'close');

    wrapper.querySelector('#inner').dispatchEvent(new window.MouseEvent('click', { bubbles: true }));

    expect(closeSpy.callCount).toBe(0);
    closeSpy.restore();
  });

  it('does not close on a click on the anchor itself', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    flushOutsideClickBind();
    const closeSpy = spyOn(overlay, 'close');

    anchor.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));

    expect(closeSpy.callCount).toBe(0);
    closeSpy.restore();
  });

  it('closes on Escape when trapFocus is false (default)', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    const closeSpy = spyOn(overlay, 'close');

    document.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape' }));

    expect(closeSpy.callCount).toBe(1);
    closeSpy.restore();
  });

  it('does not bind its own Escape handler when trapFocus is true', () => {
    overlay = new PopoverOverlay({ anchor, template: '<button>focusable</button>', trapFocus: true });
    overlay.open();
    const closeSpy = spyOn(overlay, 'close');

    document.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape' }));

    expect(closeSpy.callCount).toBe(0);
    closeSpy.restore();
  });

  it('recomputes position on window scroll and resize', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    const updateSpy = spyOn(overlay, 'updatePosition');

    window.dispatchEvent(new window.Event('scroll'));
    expect(updateSpy.callCount).toBe(1);

    window.dispatchEvent(new window.Event('resize'));
    expect(updateSpy.callCount).toBe(2);

    updateSpy.restore();
  });

  it('cancels the pending outside-click bind timer if closed before it fires', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    overlay.open();
    expect(getTimerCount()).toBe(2); // outside-click bind (0ms) + show rAF (16ms)

    overlay.close();
    expect(getTimerCount()).toBe(1); // outside-click timer cancelled; rAF show timer is never cancelled

    const wrapper = document.querySelector('.anchored-overlay-wrapper');
    completeTransitionGatedDestroy(wrapper);
  });

  it('defers actual removal until transitionend fires', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();
    flushShow();

    overlay.close();
    expect(document.body.contains(wrapper)).toBe(true);
    expect(wrapper.classList.contains('show')).toBe(false);

    completeTransitionGatedDestroy(wrapper);
    expect(document.body.contains(wrapper)).toBe(false);
  });

  it('close() before render() was ever called is a synchronous no-op', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });

    expect(() => overlay.close()).not.toThrow();
    expect(document.body.contains(overlay.getElement())).toBe(false);
  });

  it('guards against double close()/destroy() calls', () => {
    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();

    overlay.close();
    expect(() => overlay.close()).not.toThrow();

    completeTransitionGatedDestroy(wrapper);
    expect(document.body.contains(wrapper)).toBe(false);
  });

  it('placement: default "bottom" when it fits', () => {
    anchor.getBoundingClientRect = () => ({ top: 100, left: 100, right: 200, bottom: 120, width: 100, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 600, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.getAttribute('data-placement')).toBe('bottom');
    expect(wrapper.style.top).toBe('128px');
    expect(wrapper.style.left).toBe('125px');

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });

  it('placement: flips to "top" when "bottom" does not fit but "top" does', () => {
    anchor.getBoundingClientRect = () => ({ top: 100, left: 100, right: 200, bottom: 120, width: 100, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 140, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.getAttribute('data-placement')).toBe('top');
    expect(wrapper.style.top).toBe('62px');

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });

  it('placement: stays at the primary side when neither side fits (no flip-flop)', () => {
    anchor.getBoundingClientRect = () => ({ top: 10, left: 100, right: 200, bottom: 30, width: 100, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 35, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.getAttribute('data-placement')).toBe('bottom');

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });

  it('placement: "start"/"end" align the cross axis to the anchor edges', () => {
    anchor.getBoundingClientRect = () => ({ top: 100, left: 100, right: 200, bottom: 120, width: 100, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 600, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>', placement: 'bottom-start' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.getAttribute('data-placement')).toBe('bottom-start');
    expect(wrapper.style.left).toBe('100px');

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });

  it('placement: "left"/"right" position along the horizontal axis when they fit', () => {
    anchor.getBoundingClientRect = () => ({ top: 100, left: 300, right: 400, bottom: 120, width: 100, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 600, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>', placement: 'left' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.getAttribute('data-placement')).toBe('left');
    expect(wrapper.style.left).toBe('242px');

    overlay.setAnchorPoint(500, 100);
    const overlay2 = new PopoverOverlay({ anchor, template: '<p>x</p>', placement: 'right' });
    const wrapper2 = overlay2.open();
    wrapper2.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay2.updatePosition();

    expect(wrapper2.getAttribute('data-placement')).toBe('right');

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });

  it('placement: "end" align on the vertical cross axis anchors to the far edge', () => {
    anchor.getBoundingClientRect = () => ({ top: 100, left: 300, right: 400, bottom: 120, width: 100, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 600, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>', placement: 'left-end' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.getAttribute('data-placement')).toBe('left-end');
    expect(wrapper.style.top).toBe(`${120 - 30}px`);

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });

  it('placement: clamps the cross axis so the wrapper does not overflow the viewport', () => {
    anchor.getBoundingClientRect = () => ({ top: 100, left: -5, right: 5, bottom: 120, width: 10, height: 20 });
    Object.defineProperty(document.documentElement, 'clientWidth', { value: 800, configurable: true });
    Object.defineProperty(document.documentElement, 'clientHeight', { value: 600, configurable: true });

    overlay = new PopoverOverlay({ anchor, template: '<p>x</p>' });
    const wrapper = overlay.open();
    wrapper.getBoundingClientRect = () => ({ top: 0, left: 0, right: 50, bottom: 30, width: 50, height: 30 });
    overlay.updatePosition();

    expect(wrapper.style.left).toBe('8px');

    delete document.documentElement.clientWidth;
    delete document.documentElement.clientHeight;
  });
});
