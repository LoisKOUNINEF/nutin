@use "sass:map";
@use "../core/overlay-variables" as *;

$notification-banner-colors: $semantic-colors !default;

$notification-banner-config: (
  'padding': 0.75rem 1.5rem,
  'gap': 1rem,
  'actions-gap': 0.75rem,
  'close-font-size': 1.25rem,
  'animation-duration': 0.3s,
) !default;

.notification-banner-region__top,
.notification-banner-region__bottom {
  position: fixed;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  pointer-events: none;

  .app-notification-banner {
    pointer-events: auto;
  }
}

.notification-banner-region__top {
  top: 0;
}

.notification-banner-region__bottom {
  bottom: 0;
  flex-direction: column-reverse;
}

.app-notification-banner {
  z-index: map.get($overlay-z-index, notification-banner);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: map.get($notification-banner-config, 'gap');
  width: 100%;
  padding: map.get($notification-banner-config, 'padding');
  color: map.get($notification-banner-colors, 'text');
  animation: notification-banner-fade-in map.get($notification-banner-config, 'animation-duration') ease;
}

.app-notification-banner--info    { background: map.get($notification-banner-colors, 'info'); }
.app-notification-banner--success { background: map.get($notification-banner-colors, 'success'); }
.app-notification-banner--error   { background: map.get($notification-banner-colors, 'error'); }
.app-notification-banner--warning { background: map.get($notification-banner-colors, 'warning'); }

.app-notification-banner__actions {
  display: flex;
  align-items: center;
  gap: map.get($notification-banner-config, 'actions-gap');
}

.app-notification-banner__action,
.app-notification-banner__close {
  background: transparent;
  border: none;
  color: inherit;
  font-weight: bold;
  cursor: pointer;
}

.app-notification-banner__close {
  font-size: map.get($notification-banner-config, 'close-font-size');
  line-height: 1;
}

@keyframes notification-banner-fade-in {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}
