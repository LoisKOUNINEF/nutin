import { notify, _resetSnackbarForTesting } from '#root/dist/src/libs/overlays/passive/snackbar.js';

// Also the vehicle for PassiveOverlayRuntime's shared base behavior (enqueue/
// maxStack clamping/_onItemDismissed requeue/_autoDismiss) — see the plan's
// module-singleton hazard notes for why there's no separate core test file.
describe('Snackbar (via notify())', () => {
  beforeEach(() => {
    document.querySelectorAll('.snackbar-region').forEach(el => el.remove());
    _resetSnackbarForTesting();
    useFakeTimers();
  });

  afterEach(() => {
    runAllTimers();
    useRealTimers();
  });

  it('sets aria-live/aria-atomic/aria-relevant on the region (PassiveOverlayRuntime base behavior)', () => {
    notify('hello');
    const region = document.querySelector('.snackbar-region');

    expect(region.getAttribute('aria-live')).toBe('polite');
    expect(region.getAttribute('aria-atomic')).toBe('false');
    expect(region.getAttribute('aria-relevant')).toBe('additions removals');
  });

  it('shows immediately under the default maxStack of 1', () => {
    notify('hello');
    const region = document.querySelector('.snackbar-region');

    expect(region.querySelectorAll('.app-snackbar').length).toBe(1);
  });

  it('queues a second notify() while the first is still active (PassiveOverlayRuntime.enqueue)', () => {
    notify('first');
    notify('second');
    const region = document.querySelector('.snackbar-region');

    expect(region.querySelectorAll('.app-snackbar').length).toBe(1);
    expect(getTimerCount()).toBe(1);
  });

  it('shows the queued item once the active one auto-dismisses (PassiveOverlayRuntime._onItemDismissed requeue)', () => {
    notify('first');
    notify('second');
    const region = document.querySelector('.snackbar-region');

    advanceTimersByTime(3000);

    expect(region.textContent).toContain('second');
    expect(region.querySelectorAll('.app-snackbar').length).toBe(1);
  });

  it('maxStack raises the concurrent-show cap', () => {
    notify('first', { maxStack: 2 });
    notify('second', { maxStack: 2 });
    notify('third', { maxStack: 2 });
    const region = document.querySelector('.snackbar-region');

    expect(region.querySelectorAll('.app-snackbar').length).toBe(2);
  });

  it('setMaxStack clamps to a minimum of 1, even if maxStack:0 is passed', () => {
    notify('first', { maxStack: 0 });
    notify('second', { maxStack: 0 });
    const region = document.querySelector('.snackbar-region');

    expect(region.querySelectorAll('.app-snackbar').length).toBe(1);
  });

  it('defaults: duration 3000ms, type "info", position "bottom"', () => {
    notify('hello');
    const region = document.querySelector('.snackbar-region');
    const el = region.querySelector('.app-snackbar');

    expect(el.classList.contains('app-snackbar--info')).toBe(true);
    expect(el.getAttribute('role')).toBe('status');
    expect(el.getAttribute('aria-live')).toBe('polite');
    expect(region.querySelector('.snackbar-region__bottom').contains(el)).toBe(true);

    advanceTimersByTime(2999);
    expect(document.body.contains(el)).toBe(true);
    advanceTimersByTime(1);
    expect(document.body.contains(el)).toBe(false);
  });

  it('type "error" gets role="alert" and aria-live="assertive"', () => {
    notify('uh oh', { type: 'error' });
    const el = document.querySelector('.app-snackbar');

    expect(el.getAttribute('role')).toBe('alert');
    expect(el.getAttribute('aria-live')).toBe('assertive');
  });

  it('position "top" routes into snackbar-region__top', () => {
    notify('hello', { position: 'top' });
    const region = document.querySelector('.snackbar-region');
    const el = region.querySelector('.app-snackbar');

    expect(region.querySelector('.snackbar-region__top').contains(el)).toBe(true);
  });

  it('action button click calls onAction, removes the element, and dismisses immediately (before the auto-dismiss timer)', () => {
    let actioned = false;
    notify('hello', { actionText: 'Undo', onAction: () => { actioned = true; } });
    const el = document.querySelector('.app-snackbar');
    const btn = el.querySelector('button');

    click(btn);

    expect(actioned).toBe(true);
    expect(document.body.contains(el)).toBe(false);
  });

  it('sanitizes message and actionText', () => {
    notify('<script>alert(1)</script>Hi', { actionText: '<script>alert(2)</script>Go' });
    const el = document.querySelector('.app-snackbar');

    expect(el.innerHTML).not.toContain('<script>');
  });

  it('cancels the pending auto-dismiss timer when an item is manually dismissed early, avoiding a stale double-decrement of _activeCount', () => {
    let actioned = false;
    notify('first', { actionText: 'Undo', onAction: () => { actioned = true; } });
    const firstEl = document.querySelector('.app-snackbar');
    const timerCountAfterShow = getTimerCount();

    click(firstEl.querySelector('button'));
    expect(actioned).toBe(true);
    expect(document.body.contains(firstEl)).toBe(false);
    expect(getTimerCount()).toBe(timerCountAfterShow - 1);

    // Would have double-fired the stale timer and corrupted _activeCount
    // before the fix; now there's nothing left to fire.
    advanceTimersByTime(3000);

    notify('second');
    notify('third');
    const region = document.querySelector('.snackbar-region');

    // maxStack is still nominally 1 — only one should be showing, the other queued.
    expect(region.querySelectorAll('.app-snackbar').length).toBe(1);
  });
});
