import { DrawerOverlay } from '#root/dist/src/libs/overlays/drawer/drawer.js';
import { Overlays } from '#root/dist/src/core/index.js';
import { completeTransitionGatedDestroy } from '#root/src/libs/overlays/core/helpers/overlay-lifecycle.helper.js';

describe('DrawerOverlay', () => {
  let overlay;

  beforeEach(() => {
    useFakeTimers();
  });

  afterEach(() => {
    document.querySelectorAll('.drawer-backdrop').forEach(backdrop => {
      const wrapper = backdrop.querySelector('.drawer-wrapper');
      if (wrapper) wrapper.dispatchEvent(new window.Event('transitionend'));
      backdrop.remove();
    });
    document.documentElement.classList.remove('no-scroll');
    document.getElementById('app').inert = false;
    overlay = null;
    useRealTimers();
  });

  it('defaults edge to "right"', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();

    expect(backdrop.querySelector('.drawer-wrapper').classList.contains('drawer-wrapper--right')).toBe(true);
  });

  it('supports all 4 edges', () => {
    for (const edge of ['left', 'right', 'top', 'bottom']) {
      overlay = new DrawerOverlay({ template: '<p>x</p>', edge });
      const backdrop = overlay.open();
      const wrapper = backdrop.querySelector('.drawer-wrapper');

      expect(wrapper.classList.contains(`drawer-wrapper--${edge}`)).toBe(true);

      overlay.close();
      completeTransitionGatedDestroy(wrapper);
    }
  });

  it('calls the onClose callback on destroy when provided', () => {
    let called = false;
    overlay = new DrawerOverlay({ template: '<p>x</p>', onClose: () => { called = true; } });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');

    overlay.close();
    completeTransitionGatedDestroy(wrapper);

    expect(called).toBe(true);
  });

  it('emits Overlays.overlayOpened("drawer") on render and overlayClosed("drawer") on destroy', () => {
    const openedSpy = spyOn(Overlays, 'overlayOpened');
    const closedSpy = spyOn(Overlays, 'overlayClosed');

    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');

    expect(openedSpy.callCount).toBe(1);
    expect(openedSpy.lastCall).toEqual(['drawer']);
    expect(closedSpy.callCount).toBe(0);

    overlay.close();
    completeTransitionGatedDestroy(wrapper);

    expect(closedSpy.callCount).toBe(1);
    expect(closedSpy.lastCall).toEqual(['drawer']);

    openedSpy.restore();
    closedSpy.restore();
  });
});
