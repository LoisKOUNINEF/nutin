@use "sass:map";
@use "../core/overlay-variables" as *;

$drawer-config: (
  'transition-duration': 0.3s,
  'width': min(400px, 90vw),
  'height': min(480px, 90vh),
  'content-padding': 1.5rem,
  'shadow-offset-y': 2px,
  'shadow-blur': 10px,
  'shadow-fade': 80%,
  'color-overlay': rgba(0, 0, 0, 0.5),
  'color-background': #ffffff,
  'color-text': #111827,
) !default;

.drawer-backdrop {
  z-index: map.get($overlay-z-index, drawer-backdrop);
  position: fixed;
  inset: 0;
  backdrop-filter: blur(5px);
  background-color: map.get($drawer-config, 'color-overlay');
  opacity: 0;

  &.show {
    animation: modal-show map.get($drawer-config, 'transition-duration') ease forwards;
  }
}

.drawer-wrapper {
  position: fixed;
  z-index: map.get($overlay-z-index, drawer);
  background: map.get($drawer-config, 'color-background');
  color: map.get($drawer-config, 'color-text');
  box-shadow:
    0
    map.get($drawer-config, 'shadow-offset-y')
    map.get($drawer-config, 'shadow-blur')
    color-mix(in srgb, map.get($drawer-config, 'color-text'), transparent map.get($drawer-config, 'shadow-fade'));
  overflow-y: auto;
  transition: transform map.get($drawer-config, 'transition-duration') ease;

  &--left,
  &--right {
    top: 0;
    bottom: 0;
    width: map.get($drawer-config, 'width');
  }

  &--top,
  &--bottom {
    left: 0;
    right: 0;
    height: map.get($drawer-config, 'height');
  }

  &--left { left: 0; transform: translateX(-100%); }
  &--right { right: 0; transform: translateX(100%); }
  &--top { top: 0; transform: translateY(-100%); }
  &--bottom { bottom: 0; transform: translateY(100%); }

  &.show {
    transform: translate(0, 0);
  }
}

.drawer-content {
  position: relative;
  height: 100%;
  overflow-y: auto;
  padding: map.get($drawer-config, 'content-padding');
}
