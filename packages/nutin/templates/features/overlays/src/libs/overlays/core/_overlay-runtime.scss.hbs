@use "sass:map";
@use "overlay-variables" as *;

$overlay-runtime-config: (
  'z-index': map.get($overlay-z-index, snackbar),
) !default;

html.no-scroll {
  overflow: hidden;
  scrollbar-gutter: stable;
}

.passive-overlay-region {
  position: fixed;
  pointer-events: none;
  inset: 0;
  z-index: map.get($overlay-runtime-config, 'z-index');

  > * {
    pointer-events: auto;
  }
}
