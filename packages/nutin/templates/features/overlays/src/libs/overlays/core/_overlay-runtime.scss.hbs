@use "sass:map";
@use "overlay-variables" as *;
@use "../../../styles/nutin-config" as config;

$overlay-runtime-defaults: (
  'z-index': map.get($overlay-z-index, snackbar),
);

$overlay-runtime-config: map.deep-merge(
  $overlay-runtime-defaults,
  map.get(config.$config, 'components', 'overlay-runtime') or ()
);

html.no-scroll {
  overflow: hidden;
  scrollbar-gutter: stable;
}

.passive-overlay-region {
  position: fixed;
  pointer-events: none;
  inset: 0;
  z-index: map.get($overlay-runtime-config, 'z-index');

  > * {
    pointer-events: auto;
  }
}
