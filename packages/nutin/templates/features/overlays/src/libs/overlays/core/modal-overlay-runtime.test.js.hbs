import { DrawerOverlay } from '#root/dist/src/libs/overlays/drawer/drawer.js';
import { flushShow, completeTransitionGatedDestroy } from '#root/src/libs/overlays/core/helpers/overlay-lifecycle.helper.js';

describe('ModalOverlayRuntime (via DrawerOverlay)', () => {
  let overlay;

  beforeEach(() => {
    useFakeTimers();
  });

  afterEach(() => {
    document.querySelectorAll('.drawer-backdrop').forEach(backdrop => {
      const wrapper = backdrop.querySelector('.drawer-wrapper');
      if (wrapper) wrapper.dispatchEvent(new window.Event('transitionend'));
      backdrop.remove();
    });
    document.documentElement.classList.remove('no-scroll');
    document.getElementById('app').inert = false;
    overlay = null;
    useRealTimers();
  });

  it('locks scroll on every render() call, before the rest of the pipeline runs', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    expect(document.documentElement.classList.contains('no-scroll')).toBe(false);

    overlay.open();
    expect(document.documentElement.classList.contains('no-scroll')).toBe(true);
  });

  it('appends a close button with aria-label="Close dialog" when dismissible (default)', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();

    const btn = backdrop.querySelector('.modal-close-button');
    expect(btn).toBeDefined();
    expect(btn.getAttribute('aria-label')).toBe('Close dialog');
  });

  it('does not append a close button when dismissible:false', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>', dismissible: false });
    const backdrop = overlay.open();

    expect(backdrop.querySelector('.modal-close-button')).toBe(null);
  });

  it('clicking the close button calls close() (proves the second autoBindEvents() call wired it)', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();
    const closeSpy = spyOn(overlay, 'close');

    click(backdrop.querySelector('.modal-close-button'));

    expect(closeSpy.callCount).toBe(1);
    closeSpy.restore();
  });

  it('backdrop click closes only when the click target is the backdrop itself, not a descendant', () => {
    overlay = new DrawerOverlay({ template: '<p id="inner">x</p>' });
    const backdrop = overlay.open();
    const closeSpy = spyOn(overlay, 'close');

    click(backdrop.querySelector('#inner'));
    expect(closeSpy.callCount).toBe(0);

    click(backdrop);
    expect(closeSpy.callCount).toBe(1);

    closeSpy.restore();
  });

  it('does not bind a backdrop-click listener at all when dismissible:false', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>', dismissible: false });
    const backdrop = overlay.open();
    const closeSpy = spyOn(overlay, 'close');

    click(backdrop);

    expect(closeSpy.callCount).toBe(0);
    closeSpy.restore();
  });

  it('auto-labels the wrapper from the first heading in content', () => {
    overlay = new DrawerOverlay({ template: '<h2>Drawer title</h2>' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');
    const heading = backdrop.querySelector('h2');

    expect(heading.id).toBe('modal-label');
    expect(wrapper.getAttribute('aria-labelledby')).toBe('modal-label');
  });

  it('uses dialogLabel to build the heading id when both a heading and dialogLabel are given', () => {
    overlay = new DrawerOverlay({ template: '<h2>Title</h2>', dialogLabel: 'my-drawer' });
    const backdrop = overlay.open();
    const heading = backdrop.querySelector('h2');
    const wrapper = backdrop.querySelector('.drawer-wrapper');

    expect(heading.id).toBe('my-drawer-label');
    expect(wrapper.getAttribute('aria-labelledby')).toBe('my-drawer-label');
  });

  it('sets aria-labelledby to a dangling id when dialogLabel is set but no heading exists', () => {
    overlay = new DrawerOverlay({ template: '<p>no heading here</p>', dialogLabel: 'my-drawer' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');

    expect(wrapper.getAttribute('aria-labelledby')).toBe('my-drawer-label');
    expect(document.getElementById('my-drawer-label')).toBe(null);
  });

  it('always activates a focus trap, unlike AnchoredOverlayRuntime where it is opt-in', () => {
    overlay = new DrawerOverlay({ template: '<button>focusable</button>' });
    overlay.open();

    expect(document.getElementById('app').inert).toBe(true);
  });

  it('does not add "show" to the backdrop/wrapper synchronously; only after the rAF flush', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');

    expect(backdrop.classList.contains('show')).toBe(false);
    expect(wrapper.classList.contains('show')).toBe(false);

    flushShow();

    expect(backdrop.classList.contains('show')).toBe(true);
    expect(wrapper.classList.contains('show')).toBe(true);
  });

  it('defers scroll unlock and DOM removal until transitionend fires on the wrapper', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');
    flushShow();

    overlay.close();
    expect(document.documentElement.classList.contains('no-scroll')).toBe(true);
    expect(document.body.contains(backdrop)).toBe(true);

    completeTransitionGatedDestroy(wrapper);
    expect(document.documentElement.classList.contains('no-scroll')).toBe(false);
    expect(document.body.contains(backdrop)).toBe(false);
  });

  it('guards against double close()/destroy() calls', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });
    const backdrop = overlay.open();
    const wrapper = backdrop.querySelector('.drawer-wrapper');

    overlay.close();
    expect(() => overlay.close()).not.toThrow();

    completeTransitionGatedDestroy(wrapper);
    expect(document.body.contains(backdrop)).toBe(false);
  });

  it('close() before render() was ever called is a synchronous no-op', () => {
    overlay = new DrawerOverlay({ template: '<p>x</p>' });

    expect(() => overlay.close()).not.toThrow();
  });
});
