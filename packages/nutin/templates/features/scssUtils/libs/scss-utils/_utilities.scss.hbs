@use "sass:map";
@use "variables" as *;
@use "./mixins-nutin";

.u-hide {
  @include mixins-nutin.hide;
}

.u-hide-on-medium {
  @include mixins-nutin.respond-to(medium) {
    @include mixins-nutin.hide;
  }
}

.u-hide-on-small {
  @include mixins-nutin.respond-to(small) {
    @include mixins-nutin.hide;
  }
}

.u-pre-wrap {
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

.u-btn-disabled {
  @include mixins-nutin.button-disabled;
}

.u-sr-only {
  @include mixins-nutin.sr-only;
}

.u-clearfix {
  @include mixins-nutin.clearfix;
}

.u-pointer {
  @include mixins-nutin.cursor-pointer;
}