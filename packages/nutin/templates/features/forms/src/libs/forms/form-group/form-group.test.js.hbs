import { FormGroup } from '#root/dist/src/libs/forms/form-group/form-group.js';

function makeField({ value = '', valid = true } = {}) {
  const wrapper = document.createElement('div');
  const input = document.createElement('input');
  wrapper.appendChild(input);
  document.body.appendChild(wrapper);
  return {
    calls: [],
    _value: value,
    _valid: valid,
    input,
    getValue() { return this._value; },
    validate() { this.calls.push('validate'); return this._valid; },
    get valid() { return this._valid; },
    reset() { this.calls.push('reset'); },
    markAsTouched() { this.calls.push('markAsTouched'); },
    element: wrapper,
  };
}

describe('FormGroup', () => {
  let form;

  beforeEach(() => {
    form = document.createElement('form');
    document.body.appendChild(form);
  });

  afterEach(() => {
    form.remove();
    form = null;
  });

  it('sets novalidate on the form element', () => {
    new FormGroup(form, {});
    expect(form.hasAttribute('novalidate')).toBe(true);
  });

  it('submit prevents the default action', () => {
    new FormGroup(form, {});
    let defaultPrevented;
    form.addEventListener('submit', (e) => { defaultPrevented = e.defaultPrevented; });
    form.dispatchEvent(new window.Event('submit', { cancelable: true }));
    expect(defaultPrevented).toBe(true);
  });

  it('submit marks every field touched and validates every field', () => {
    const a = makeField();
    const b = makeField();
    new FormGroup(form, { a, b });

    form.dispatchEvent(new window.Event('submit', { cancelable: true }));

    expect(a.calls).toEqual(['markAsTouched', 'validate']);
    expect(b.calls).toEqual(['markAsTouched', 'validate']);
  });

  it('calls onSubmit with getValues() when every field is valid', () => {
    const a = makeField({ value: 'x', valid: true });
    const b = makeField({ value: 'y', valid: true });
    let received = null;
    const group = new FormGroup(form, { a, b }, { onSubmit: (values) => { received = values; } });

    form.dispatchEvent(new window.Event('submit', { cancelable: true }));

    expect(received).toEqual({ a: 'x', b: 'y' });
    expect(group.valid).toBe(true);
  });

  it('does not throw when the form is valid and no onSubmit callback is provided', () => {
    const a = makeField({ valid: true });
    new FormGroup(form, { a });
    expect(() => form.dispatchEvent(new window.Event('submit', { cancelable: true }))).not.toThrow();
  });

  it('calls onValidationFail with invalid field names, and does not call onSubmit, when any field is invalid', () => {
    const a = makeField({ valid: false });
    const b = makeField({ valid: true });
    let invalidNames = null;
    let submitCalled = false;
    new FormGroup(form, { a, b }, {
      onValidationFail: (names) => { invalidNames = names; },
      onSubmit: () => { submitCalled = true; },
    });

    form.dispatchEvent(new window.Event('submit', { cancelable: true }));

    expect(invalidNames).toEqual(['a']);
    expect(submitCalled).toBe(false);
  });

  it("focuses the first invalid field's focusable element on a failed submit", () => {
    const a = makeField({ valid: true });
    const b = makeField({ valid: false });
    new FormGroup(form, { a, b }, {});

    form.dispatchEvent(new window.Event('submit', { cancelable: true }));

    expect(document.activeElement).toBe(b.input);
  });

  it("getValues() returns each field's current value keyed by field name", () => {
    const a = makeField({ value: 'x' });
    const group = new FormGroup(form, { a });
    expect(group.getValues()).toEqual({ a: 'x' });
  });

  it('validate() validates every field and returns overall validity', () => {
    const a = makeField({ valid: false });
    const group = new FormGroup(form, { a });
    expect(group.validate()).toBe(false);
    expect(a.calls).toEqual(['validate']);
  });

  it('valid getter reflects whether every field is valid', () => {
    const a = makeField({ valid: true });
    const b = makeField({ valid: false });
    const group = new FormGroup(form, { a, b });
    expect(group.valid).toBe(false);
  });

  it('reset() resets every field', () => {
    const a = makeField();
    const b = makeField();
    const group = new FormGroup(form, { a, b });
    group.reset();
    expect(a.calls).toEqual(['reset']);
    expect(b.calls).toEqual(['reset']);
  });

  it('getField(name) returns the named field, or undefined when missing', () => {
    const a = makeField();
    const group = new FormGroup(form, { a });
    expect(group.getField('a')).toBe(a);
    expect(group.getField('missing')).toBeUndefined();
  });

  it('destroy() removes the submit listener, so submit no longer triggers validation', () => {
    const a = makeField();
    const group = new FormGroup(form, { a });
    group.destroy();

    form.dispatchEvent(new window.Event('submit', { cancelable: true }));

    expect(a.calls).toEqual([]);
  });
});
