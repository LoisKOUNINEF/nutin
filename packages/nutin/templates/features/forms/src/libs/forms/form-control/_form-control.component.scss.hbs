@use "sass:map";
@use "variables" as *;

$form-control-config: (
  'gap': map.get($spacings, "smallest"),
  'disabled-opacity': 0.6,
  'label-font-size': map.get($font-sizes, "small"),
  'label-font-weight': 600,
  'line-height': 1.4,
  'required-line-height': 1,
  'input-padding-y': map.get($spacings, "small"),
  'input-padding-x': map.get($spacings, "medium"),
  'input-border-width': 1px,
  'input-border-radius': map.get($border-radius, "medium"),
  'input-font-family': $primary-font,
  'input-font-size': map.get($font-sizes, "medium"),
  'input-transition-duration': map.get($transitions, "fast"),
  'placeholder-opacity': 0.7,
  'focus-outline-width': 2px,
  'focus-outline-offset': 2px,
  'textarea-min-height': 6rem,
  'color-error': var(--error),
  'color-text-muted': var(--text-muted),
  'color-surface': var(--surface),
  'color-text': var(--text),
  'color-border': var(--border),
  'color-border-strong': var(--border-strong),
  'color-primary': var(--primary),
  'color-disabled-bg': var(--disabled-bg),
  'color-disabled-text': var(--disabled-text),
) !default;

.app-form-control {
  display: flex;
  flex-direction: column;
  gap: map.get($form-control-config, 'gap');
  width: 100%;

  &.form-control--disabled {
    opacity: map.get($form-control-config, 'disabled-opacity');
    cursor: not-allowed;
  }

  &.form-control--error .form-control__input {
    border-color: map.get($form-control-config, 'color-error');

    &:focus-visible {
      outline-color: map.get($form-control-config, 'color-error');
      border-color: map.get($form-control-config, 'color-error');
    }
  }
}

.form-control__label {
  display: inline-flex;
  align-items: baseline;
  gap: map.get($form-control-config, 'gap');
}

.form-control__label-text {
  font-size: map.get($form-control-config, 'label-font-size');
  font-weight: map.get($form-control-config, 'label-font-weight');
  color: map.get($form-control-config, 'color-text-muted');

  &:empty { display: none; }
}

.form-control__required {
  color: map.get($form-control-config, 'color-error');
  font-size: map.get($form-control-config, 'label-font-size');
  font-weight: map.get($form-control-config, 'label-font-weight');
  line-height: map.get($form-control-config, 'required-line-height');
}

.form-control__input {
  width: 100%;
  padding: map.get($form-control-config, 'input-padding-y') map.get($form-control-config, 'input-padding-x');
  background-color: map.get($form-control-config, 'color-surface');
  color: map.get($form-control-config, 'color-text');
  border: map.get($form-control-config, 'input-border-width') solid map.get($form-control-config, 'color-border');
  border-radius: map.get($form-control-config, 'input-border-radius');
  font-family: map.get($form-control-config, 'input-font-family');
  font-size: map.get($form-control-config, 'input-font-size');
  line-height: map.get($form-control-config, 'line-height');
  transition:
    border-color map.get($form-control-config, 'input-transition-duration') ease,
    box-shadow   map.get($form-control-config, 'input-transition-duration') ease;

  &::placeholder {
    color: map.get($form-control-config, 'color-text-muted');
    opacity: map.get($form-control-config, 'placeholder-opacity');
  }

  &:hover:not(:disabled) {
    border-color: map.get($form-control-config, 'color-border-strong');
  }

  &:focus-visible {
    outline: map.get($form-control-config, 'focus-outline-width') solid map.get($form-control-config, 'color-primary');
    outline-offset: map.get($form-control-config, 'focus-outline-offset');
    border-color: map.get($form-control-config, 'color-primary');
  }

  &:disabled {
    background-color: map.get($form-control-config, 'color-disabled-bg');
    color: map.get($form-control-config, 'color-disabled-text');
    border-color: map.get($form-control-config, 'color-border');
    cursor: not-allowed;
  }

  textarea {
    resize: vertical;
    min-height: map.get($form-control-config, 'textarea-min-height');
  }
}

.form-control__error {
  font-size: map.get($form-control-config, 'label-font-size');
  color: map.get($form-control-config, 'color-error');
  line-height: map.get($form-control-config, 'line-height');

  &:empty { display: none; }
}
