import { Validators } from '#root/dist/src/libs/forms/validators/validators.js';

describe('Validators', () => {
  it('required fails for an empty string', () => {
    expect(Validators.required('')).toBe('validators.required');
  });

  it('required fails for a whitespace-only string', () => {
    expect(Validators.required('   ')).toBe('validators.required');
  });

  it('required passes for a non-empty string', () => {
    expect(Validators.required('hello')).toBe(null);
  });

  it('email passes for a valid address', () => {
    expect(Validators.email('user@example.com')).toBe(null);
  });

  it('email fails for a string with no @', () => {
    expect(Validators.email('user.example.com')).toBe('validators.email');
  });

  it('email fails for a string with no domain', () => {
    expect(Validators.email('user@')).toBe('validators.email');
  });

  it('email fails for a string containing spaces', () => {
    expect(Validators.email('user @example.com')).toBe('validators.email');
  });

  it('minLength passes at exactly the boundary and fails one below it', () => {
    const fn = Validators.minLength(3);
    expect(fn('abc')).toBe(null);
    expect(fn('ab')).toBe('validators.minLength');
  });

  it('maxLength passes at exactly the boundary and fails one above it', () => {
    const fn = Validators.maxLength(3);
    expect(fn('abc')).toBe(null);
    expect(fn('abcd')).toBe('validators.maxLength');
  });

  it('pattern passes on a match and fails with the default error key otherwise', () => {
    const fn = Validators.pattern(/^\d+$/);
    expect(fn('123')).toBe(null);
    expect(fn('abc')).toBe('validators.pattern');
  });

  it('pattern uses a custom error key when given', () => {
    const fn = Validators.pattern(/^\d+$/, 'validators.digitsOnly');
    expect(fn('abc')).toBe('validators.digitsOnly');
  });

  it('compose returns null when every validator passes', () => {
    const fn = Validators.compose(Validators.required, Validators.minLength(2));
    expect(fn('hi')).toBe(null);
  });

  it('compose returns the first failing validator\'s message and short-circuits', () => {
    let secondCalled = false;
    const second = () => { secondCalled = true; return 'never gets here in message, but tracked'; };
    const fn = Validators.compose(Validators.required, second);
    expect(fn('')).toBe('validators.required');
    expect(secondCalled).toBe(false);
  });

  it('compose with no validators always passes', () => {
    const fn = Validators.compose();
    expect(fn('anything')).toBe(null);
  });
});
