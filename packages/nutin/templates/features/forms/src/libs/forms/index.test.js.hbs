import { asFormField } from '#root/dist/src/libs/forms/index.js';

function makeComponent({ value = '' } = {}) {
  const el = document.createElement('div');
  return {
    _value: value,
    element: el,
    getValue() { return this._value; },
    setValue(v) { this._value = v; },
  };
}

describe('asFormField', () => {
  it('getValue() delegates to the wrapped component', () => {
    const component = makeComponent({ value: 'hi' });
    const field = asFormField(component);
    expect(field.getValue()).toBe('hi');
  });

  it('element getter delegates to the wrapped component', () => {
    const component = makeComponent();
    const field = asFormField(component);
    expect(field.element).toBe(component.element);
  });

  it('validate() runs validators against the current value and reports validity', () => {
    const component = makeComponent({ value: '' });
    const field = asFormField(component, [(v) => v.length > 0 ? null : 'required']);
    expect(field.validate()).toBe(false);
    expect(field.valid).toBe(false);

    component.setValue('now set');
    expect(field.validate()).toBe(true);
    expect(field.valid).toBe(true);
  });

  it('valid getter reflects the outcome of the last validate() call, not a live re-check', () => {
    const component = makeComponent({ value: '' });
    const field = asFormField(component, [(v) => v.length > 0 ? null : 'required']);
    field.validate();
    expect(field.valid).toBe(false);

    component.setValue('now set');
    expect(field.valid).toBe(false);

    field.validate();
    expect(field.valid).toBe(true);
  });

  it('validate() coerces non-string values via String() before validating', () => {
    const component = makeComponent({ value: false });
    const field = asFormField(component, [(v) => v === 'false' ? null : 'bad']);
    expect(field.validate()).toBe(true);
  });

  it("reset() calls component.setValue('') by default", () => {
    const component = makeComponent({ value: 'x' });
    const field = asFormField(component);
    field.reset();
    expect(component._value).toBe('');
  });

  it('reset() calls a custom reset override instead of the default setValue(\'\')', () => {
    let customCalled = false;
    const component = makeComponent({ value: 'x' });
    const field = asFormField(component, [], { reset: () => { customCalled = true; } });
    field.reset();
    expect(customCalled).toBe(true);
    expect(component._value).toBe('x');
  });

  it('markAsTouched() runs validate()', () => {
    const component = makeComponent({ value: '' });
    const field = asFormField(component, [(v) => v.length > 0 ? null : 'required']);
    field.markAsTouched();
    expect(field.valid).toBe(false);
  });

  it('an empty validators array always validates as true', () => {
    const component = makeComponent({ value: '' });
    const field = asFormField(component);
    expect(field.validate()).toBe(true);
  });
});
