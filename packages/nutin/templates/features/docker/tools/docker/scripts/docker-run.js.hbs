#!/usr/bin/env node

import { readFileSync } from 'fs';
import path from 'path';
import { spawn, spawnSync } from 'child_process';
import { print, errorExit, isDryRun } from '../../utils/index.js';
import nutinConfig from '../../../nutin.config.js';
import { validateDockerPorts } from './docker-ports.js';
import { RUN_FLAGS, parseDockerFlags, runCommand, imageName, containerName, helpText } from './docker-args.js';

const USAGE = '{{#if (eq packageManager "npm")}}npm run docker:run -- [flags]{{else}}{{packageManager}} run docker:run [flags]{{/if}}';

let flags;
try {
  flags = parseDockerFlags(process.argv.slice(2), RUN_FLAGS);
} catch (err) {
  errorExit(err.message, 'docker:run');
}

if (flags.help) {
  console.info(helpText(RUN_FLAGS, USAGE));
  process.exit(0);
}

const { name: projectName } = JSON.parse(readFileSync(path.join(process.cwd(), 'package.json'), 'utf-8'));

let command;
try {
  const ports = validateDockerPorts(nutinConfig.dockerPorts);
  command = { ...runCommand(flags, { image: imageName(projectName), container: containerName(projectName), ports }), ports };
} catch (err) {
  errorExit(err.message, 'docker:run');
}

const { args, name, rm, ports } = command;
// isDryRun(): "npm run docker:run --dry-run"
const dryRun = flags['dry-run'] || isDryRun();

// Docker's own error for a taken name is a long "Conflict..." line: say what to do instead.
// Exit status 0 means the container exists; anything else (none, no docker) is left to docker run.
if (spawnSync('docker', ['container', 'inspect', name], { stdio: 'ignore' }).status === 0) {
  const taken = `A container named "${name}" already exists: stop it (docker stop ${name}) and remove it (docker rm ${name}), or pass --name <other>.`;
  if (!dryRun) errorExit(taken, 'docker:run');
  print.warn(`A real run would stop here. ${taken}`);
}

if (dryRun) {
  print.boldSection(`Would run: docker ${args.join(' ')}`);
  print.info(`--help to see supported flags`);
  print.gray('Dry run: no container was started.');
  process.exit(0);
}

print.boldSection(`Running: docker ${args.join(' ')}`);
// Before docker's own output: in the foreground, that's nginx's log until Ctrl+C.
const urls = ports.map((port) => `http://localhost:${port}`).join(', ');
if (!flags.detach) print.info(`Serving on ${urls} (Ctrl+C to stop).`);

const child = spawn('docker', args, { stdio: 'inherit' });
child.on('error', (err) => {
  print.boldError(`Failed to start docker: ${err.message}.`);
  print.gray('Is Docker installed, and running?');
  process.exit(1);
});
child.on('exit', (code) => {
  if (code === 0 && flags.detach) {
    print.info(`\nContainer "${name}" is running in the background, on ${urls}.`);
    print.gray(`  Logs: docker logs -f ${name}`);
    print.gray(`  Stop: docker stop ${name}${rm ? '' : ` && docker rm ${name}`}`);
  }
  process.exit(code ?? 1);
});
