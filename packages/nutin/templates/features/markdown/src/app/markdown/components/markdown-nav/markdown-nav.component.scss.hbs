.markdown-nav__container {
  flex: 0 0 16rem;
}

.markdown-nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.markdown-nav__section + .markdown-nav__section,
.markdown-nav__group + .markdown-nav__group {
  margin-top: 1rem;
}

.markdown-nav__section-title,
.markdown-nav__group-title {
  display: block;
  font-weight: bold;
  margin-bottom: 0.25rem;
}

.markdown-nav__group-title {
  font-size: 0.875rem;
  opacity: 0.75;
}

.markdown-nav__link {
  display: block;
  padding: 0.25rem 0;
}

.markdown-nav__link--active {
  font-weight: bold;
}
