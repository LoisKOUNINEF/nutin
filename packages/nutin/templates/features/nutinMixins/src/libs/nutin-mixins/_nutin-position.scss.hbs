@mixin absolute-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

@mixin fixed-full {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

@mixin pos($pos, $t: auto, $r: auto, $b: auto, $l: auto) {
  position: $pos;
  top: $t;
  right: $r;
  bottom: $b;
  left: $l;
}
