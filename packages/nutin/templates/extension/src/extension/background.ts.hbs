{{#if (eq extension "side-panel")}}
// Extension background script: the toolbar button (and its keyboard shortcut, set in
// chrome://extensions/shortcuts) toggles the side panel. Chrome runs it as a service worker,
// Firefox as a background script.

if (chrome.sidePanel) {
  chrome.sidePanel
    .setPanelBehavior({ openPanelOnActionClick: true })
    .catch((error: unknown) => console.error('Could not set the side panel behavior:', error));
} else {
  // Firefox: toggle() only works from a user action, so it's called right in the click handler.
  chrome.action.onClicked.addListener(() => {
    browser.sidebarAction.toggle().catch((error: unknown) => console.error('Could not toggle the sidebar:', error));
  });
}

// Firefox's sidebar API, which @types/chrome doesn't know. Last: in JS projects the declaration
// goes away, and comments attached to it with it.
declare const browser: { sidebarAction: { toggle(): Promise<void> } };
{{else}}
// Extension background script: Chrome runs it as a service worker, Firefox as a background
// script. The popup opens from the toolbar button on its own; put work that must run without
// the popup open here (alarms, context menus, messages from the popup...).
{{/if}}
