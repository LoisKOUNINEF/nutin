import { Service } from '../../../core/index.js';

export type StorageAreaName = 'local' | 'sync' | 'session';
export type BrowserName = 'chrome' | 'firefox';
type StorageItems = Record<string, unknown>;
type Unsubscribe = () => void;

/**
 * The only place that touches `chrome.*`: a thin, typed surface over the extension APIs the app
 * uses. Add to it rather than calling `chrome.*` elsewhere. `chrome` is read on every call, so tests
 * can install a fake one first (testin-nutin has one: tools/testin-nutin/mocks/fake-chrome.js). Firefox implements the same
 * `chrome.*` APIs; browser() tells the two apart where the app must say or do something different.
 */
export class ChromeApiService extends Service{{#unless (eq lang "js")}}<ChromeApiService>{{/unless}} {
  constructor() {
    super();
  }

  // Firefox's extension pages are served from moz-extension:// URLs.
  public browser(): BrowserName {
    return chrome.runtime?.getURL?.('').startsWith('moz-extension:') ? 'firefox' : 'chrome';
  }

  // `local` stays on this device, `sync` follows the user's browser account (small quotas: about
  // 100 KB, 8 KB per item), `session` is cleared when the browser closes.
  public async storageGet(area: StorageAreaName, keys: string[] | null): Promise<StorageItems> {
    return chrome.storage[area].get(keys);
  }

  public async storageSet(area: StorageAreaName, items: StorageItems): Promise<void> {
    await chrome.storage[area].set(items);
  }

  public async storageRemove(area: StorageAreaName, keys: string[]): Promise<void> {
    if (keys.length > 0) await chrome.storage[area].remove(keys);
  }

  // Fires for every extension page's writes, this one's included: with each window's panel or
  // popup listening, all of them stay in step.
  public onStorageChanged(
    callback: (changes: Record<string, chrome.storage.StorageChange>, area: string) => void
  ): Unsubscribe {
    chrome.storage.onChanged.addListener(callback);
    return () => chrome.storage.onChanged.removeListener(callback);
  }

  // The active tab of the window this page is in. Its URL needs the "tabs" permission (or host
  // permissions for its site) in src/extension/manifest.json: without it, this returns null.
  public async getActiveTabUrl(): Promise<string | null> {
    const [tab] = await chrome.tabs.query({ active: true, currentWindow: true });
    return tab?.url ?? null;
  }

  // Fires when another tab is activated, or when a tab's URL changes.
  public onTabsChanged(callback: () => void): Unsubscribe {
    const onUpdated = (_tabId: number, changeInfo: { url?: string }) => {
      if (changeInfo.url) callback();
    };
    chrome.tabs.onActivated.addListener(callback);
    chrome.tabs.onUpdated.addListener(onUpdated);
    return () => {
      chrome.tabs.onActivated.removeListener(callback);
      chrome.tabs.onUpdated.removeListener(onUpdated);
    };
  }

  // Web pages only: a URL read from storage or a page can't open a script, data or extension URL.
  public async openTab(url: string): Promise<void> {
    if (!isWebPage(url)) throw new Error(`Can't open ${url}: only http(s) pages are allowed.`);
    await chrome.tabs.create({ url });
  }
}

function isWebPage(url: string): boolean {
  try {
    const { protocol } = new URL(url);
    return protocol === 'http:' || protocol === 'https:';
  } catch {
    return false;
  }
}

export const chromeApiService = ChromeApiService.getInstance();
