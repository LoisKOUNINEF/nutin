.not-found {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  padding-top: clamp(2rem, 5vw, 4rem);
  gap: 4rem;
}

.not-found__title {
  font-size: clamp(2rem, 8vw, 3rem);
  font-weight: bold;
}

.not-found__back {
  cursor: pointer;
  background-color: inherit;
  font-size: clamp(1.25rem, 5vw, 2rem);
  font-style: italic;
  padding: clamp(.75rem, 2vw, 1rem)  clamp(.5rem, 2vw, .75rem);
  border-radius: 8px;
}
