{{#if extension}}
import { initI18n } from '../core/index.js';
import { AppComponent } from './components/app/app.component.js';

// The extension page has no router: it only ever shows index.html (as chrome-extension://<id>/index.html,
// which no route would match). One root component, mounted into <main id="app">.
class App {
  constructor() {
    // Built-in data-pipe pipes (date, currency, uppercase…):
    // Import registerPipes from core and call it here to register all pipes,
    // or import AppPipeRegistry and register only the ones you use with AppPipeRegistry.register().
    // See https://www.nutin.dev/docs/api/what-pipes-are-available
    // registerPipes();
    new AppComponent('#app').render();
  }
}
{{else}}
import { AppRouter, initI18n } from '../core/index.js';
import { appRoutes } from './routes.js';

class App {
  constructor() {
    // Built-in data-pipe pipes (date, currency, uppercase…):
    // Import registerPipes from core and call it here to register all pipes,
    // or import AppPipeRegistry and register only the ones you use with AppPipeRegistry.register().
    // See https://www.nutin.dev/docs/api/what-pipes-are-available
    // registerPipes();
    AppRouter(appRoutes);
  }
}
{{/if}}

document.addEventListener('DOMContentLoaded', async () => {
  await initI18n();
  new App();
});
