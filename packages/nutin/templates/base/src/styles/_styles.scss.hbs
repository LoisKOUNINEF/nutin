@use "variables" as *;

/* ===========
   CSS Reset
   =========== */

/* Box sizing */

*,
*::before,
*::after {
  box-sizing: border-box;
}

/* Remove default spacing */

* {
  margin: 0;
  padding: 0;
}

/* Document */

html {
  font-size: 100%;
  -webkit-text-size-adjust: 100%;
}

body {
  min-height: 100vh;
  font: inherit;
  line-height: 1.5;
}

/* Media */

img,
picture,
svg,
canvas,
video {
  display: block;
  max-width: 100%;
}

/* Forms */

button,
input,
select,
textarea {
  font: inherit;
  color: inherit;
}

button {
  background: none;
  border: none;
  cursor: pointer;
}

textarea {
  resize: vertical;
}

/* Tables */

table {
  border-collapse: collapse;
  border-spacing: 0;
}

/* Lists */

ul,
ol {
  list-style: none;
}

/* Links */

a {
  color: inherit;
  text-decoration: none;
}

/* Quotes */

blockquote,
q {
  quotes: none;
}

blockquote::before,
blockquote::after,
q::before,
q::after {
  content: "";
}

/* Miscellaneous */

hr {
  border: none;
}

fieldset {
  border: none;
}

:where([hidden]) {
  display: none !important;
}
