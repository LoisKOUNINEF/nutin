import { AppEventBus } from "./event-bus.js";

// Module functions, re-exported as the `Lifecycle` namespace (see index.ts):
// the ones nothing calls are left out of the bundle.

export function beforeRender(): void {
  AppEventBus.emit('before-render');
}

export function onBeforeRender(callback: () => void): () => void {
  AppEventBus.subscribe('before-render', callback);
  return () => AppEventBus.off('before-render', callback);
}

export function afterRender(): void {
  AppEventBus.emit('after-render');
}

export function onAfterRender(callback: () => void): () => void {
  AppEventBus.subscribe('after-render', callback);
  return () => AppEventBus.off('after-render', callback);
}

export function beforeDestroy(): void {
  AppEventBus.emit('before-destroy');
}

export function onBeforeDestroy(callback: () => void): () => void {
  AppEventBus.subscribe('before-destroy', callback);
  return () => AppEventBus.off('before-destroy', callback);
}

export function afterDestroy(): void {
  AppEventBus.emit('after-destroy');
}

export function onAfterDestroy(callback: () => void): () => void {
  AppEventBus.subscribe('after-destroy', callback);
  return () => AppEventBus.off('after-destroy', callback);
}

export function viewMount(viewName: string): void {
  AppEventBus.emit('view-mount', { viewName });
}

export function onViewMount(callback: (data: { viewName: string }) => void): () => void {
  AppEventBus.subscribe('view-mount', callback);
  return () => AppEventBus.off('view-mount', callback);
}

export function viewUnmount(viewName: string): void {
  AppEventBus.emit('view-unmount', { viewName });
}

export function onViewUnmount(callback: (data: { viewName: string }) => void): () => void {
  AppEventBus.subscribe('view-unmount', callback);
  return () => AppEventBus.off('view-unmount', callback);
}
