#!/usr/bin/env node

import path from 'path';
import { print, runScript } from '../utils/index.js';
import { builderConfig } from './builder.config.js';

const scriptsDir = path.join(process.cwd(), 'tools', 'builder', 'core');

if (!builderConfig.isProd) print.section('⚠️ For production, use \'{{packageManager}} run build:prod\' ⚠️');
print.boldHead(`\nStarting build...`);

runScript(path.join(scriptsDir, 'copy-static.js'), 'Copying files...', builderConfig.isVerbose);

runScript(path.join(scriptsDir, 'validate-routes.js'), 'Validating app routes...', builderConfig.isVerbose);

if(!builderConfig.isProd) runScript(path.join(scriptsDir, 'tsc.js'), 'Running TypeScript compiler...', builderConfig.isVerbose);

if (builderConfig.inlineTemplates) {
	runScript(path.join(scriptsDir, 'minify-html.js'), 'Minifying inline templates...', builderConfig.isVerbose);
} else {
	runScript(path.join(scriptsDir, 'merge-templates.js'), 'Merging HTML templates in temp files...', builderConfig.isVerbose);
}

runScript(path.join(scriptsDir, 'sass.js'), 'Compiling styles from main.scss...', builderConfig.isVerbose);
if (builderConfig.tailwind) runScript(path.join(scriptsDir, 'tailwind.js'), 'Compiling Tailwind CSS...', builderConfig.isVerbose);

if (builderConfig.i18n) runScript(path.join(scriptsDir, 'build-i18n.js'), 'Combining locales for production...', builderConfig.isVerbose);

runScript(path.join(scriptsDir, 'validate-html.js'), 'Adding and validating tags in index.html...', builderConfig.isVerbose);

if (builderConfig.isProd) {
	runScript(path.join(scriptsDir, 'esbuild.js'), 'Running esbuild...', builderConfig.isVerbose);
	runScript(path.join(scriptsDir, 'hash-files.js'), 'Hashing files...', builderConfig.isVerbose);
	runScript(path.join(scriptsDir, 'compress-files.js'), 'Compressing files...', builderConfig.isVerbose);
	if (builderConfig.generateSEO) runScript(path.join(scriptsDir, 'generate-seo-files.js'), 'Generating SEO Files...', builderConfig.isVerbose);
}

runScript(path.join(scriptsDir, 'finalize-build.js'), 'Finalizing build...', builderConfig.isVerbose)

print.boldSuccess(`\nBuild successful!\n`);
