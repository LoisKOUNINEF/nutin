import { runCommand, print, builderConfig } from "../../utils/index.js";
import { exit } from 'process';

async function compileTS() {
  await runCommand('tsc', ['--project', 'tsconfig.json']);
  if (builderConfig.isVerbose) print.boldInfo('✅ TypeScript compiled.');
}

compileTS().catch((err) => {
  print.boldError(`Unexpected error: ${err.message}`);
  exit(1);
});
