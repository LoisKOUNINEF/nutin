import esbuild from 'esbuild';
import path from 'path';
import { errorExit, UserError } from '../../../utils/index.js';
import { PATHS } from '../app/paths.js';
import { builderConfig } from '../../builder.config.js';
import { clientDefine, slimConfigPlugin, DEV_OVERRIDES, classFeatureSupport } from './bundle-options.js';
import { readDataFilesMap } from './data-files.js';

{{#if (eq lang "js")}}
// Bundles the copied .js sources; in dev they're also kept on disk for testin-nutin.
const ENTRY_FILE = path.join(PATHS.tempApp, 'main.js');
{{else}}
// Prod bundles straight from the copied .ts sources (tsc runs --noEmit there);
// dev bundles tsc's emitted .js, which is kept on disk for testin-nutin.
const ENTRY_FILE = path.join(PATHS.tempApp, builderConfig.isProd ? 'main.ts' : 'main.js');
{{/if}}

async function build() {
  await esbuild.build({
    ...builderConfig.esbuild,
    ...(builderConfig.isProd ? {} : DEV_OVERRIDES),
    supported: { ...classFeatureSupport(builderConfig.lowerClassFeatures), ...builderConfig.esbuild.supported },
    platform: 'browser',
    format: 'esm',
    legalComments: 'none',
    loader: {
      '.json': 'json',
    },
    define: clientDefine({ ...builderConfig, dataFiles: readDataFilesMap() }),
    plugins: [slimConfigPlugin({ generateSEO: builderConfig.generateSEO })],
    // Code splitting: each dynamic import() becomes a chunk in chunks/, only fetched
    // the first time it runs. The entry still comes out as bundle.js (see add-tags.js).
    splitting: true,
    entryPoints: [{ in: ENTRY_FILE, out: 'bundle' }],
    outdir: PATHS.tempSource,
    chunkNames: `${path.basename(PATHS.tempChunks)}/[name]-[hash]`,
    keepNames: false,
  });
}

build().catch((err) => {
  // A build failure (err.errors): esbuild has printed each error with its file and line.
  errorExit(Array.isArray(err.errors) ? new UserError(`${err.errors.length} bundling error(s): see above.`) : err, 'esbuild');
});
