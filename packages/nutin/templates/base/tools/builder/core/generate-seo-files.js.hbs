import { exit } from 'process';
import { print } from '../../utils/index.js';
import { builderConfig } from '../builder.config.js';
import { generateSeoHtml } from './seo/generate-seo-html.js';
import { generateRobotsTxt } from './seo/generate-robots-txt.js';
import { generateSitemapXml } from './seo/generate-sitemap-xml.js';

function generateSeoFiles() {
  generateSeoHtml();
  if (builderConfig.isVerbose) print.info('SEO HTML generation complete.');
  generateRobotsTxt();
  if (builderConfig.isVerbose) print.info('robots.txt generation complete.');
  generateSitemapXml();
  if (builderConfig.isVerbose) print.info('sitemap.xml generation complete.');
}

try {
  generateSeoFiles();
  if (builderConfig.isVerbose) print.boldInfo('✅ SEO Files generation complete.');
} catch (err) {
  print.boldError(`[generate-seo-files] Unexpected error: ${err.message}`);
  exit(1);
}
