{{#if markdown}}
import { markdownSeoRoutes, markdownSeoOptOutPaths } from '../markdown/markdown-seo-routes.js';
{{/if}}
import { routeSuffixOf } from './route-output.js';

// Appends generated routes to config/seo.json's, skipping any whose output URL a
// seo.json entry already covers: a hand-written entry always wins.
export function mergeSeoRoutes(configRoutes, generatedRoutes) {
  const covered = new Set(configRoutes.map(routeSuffixOf));
  return [...configRoutes, ...generatedRoutes.filter((route) => !covered.has(routeSuffixOf(route)))];
}

// Every route to prerender: config/seo.json's, plus those generated by features.
export function resolveSeoRoutes(seoConfig) {
  let routes = seoConfig.routes ?? [];
{{#if markdown}}
  routes = mergeSeoRoutes(routes, markdownSeoRoutes());
{{/if}}
  return routes;
}

// App route patterns deliberately left without SEO pages: no "missing seo.json entry" warning.
export function resolveSeoOptOutPaths() {
  let paths = [];
{{#if markdown}}
  paths = [...paths, ...markdownSeoOptOutPaths()];
{{/if}}
  return paths;
}
