// The console as it was when testin-nutin started (this module is imported before any test file).
// The report is printed through console too, so a test that stubs a console method and never
// restores it (e.g. an assertion that fails before its restore())doesn't silence it:
// failures and the "✗ N failed" line would vanish.
// Once the tests have run, the real methods are put back.
const METHODS = ['log', 'info', 'warn', 'error', 'debug', 'table'];
const realConsole = Object.fromEntries(METHODS.map((method) => [method, console[method]]));

export function restoreRealConsole() {
  Object.assign(console, realConsole);
}
