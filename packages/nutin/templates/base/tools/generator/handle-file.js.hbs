import fs from 'fs';
import { print } from '../utils/index.js';
// Imported directly, not via the utils barrel: it reads nutin.config.js "i18n" on load.
import { LANGUAGES } from '../utils/languages.js';
import { localeTemplate } from './templates/index.js';

export function generateFile({
  name,
  targetPath,
  templateFn,
  suffix,
  extension = '{{#if (eq lang "js")}}js{{else}}ts{{/if}}',
  dryRun = false,
}) {
  const template = templateFn(name, targetPath, suffix);
  const filePath = `${targetPath}/${name.kebab}.${suffix}.${extension}`;

  if (fs.existsSync(filePath)) {
    print.boldError(`\nThe file already exists: ${filePath}.`);
    process.exit(1);
  }

  // --dry-run: the same checks, nothing written.
  if (!dryRun) {
    fs.mkdirSync(targetPath, { recursive: true });
    fs.writeFileSync(filePath, template);
  }
  return filePath;
}

export function generateLocalesJson({ targetPath, name, isView, dryRun = false }) {
  const localesDir = `${targetPath}/locales`;
  const filePaths = LANGUAGES.map((lang) => `${localesDir}/${lang}.json`);
  if (dryRun) return filePaths;

  fs.mkdirSync(localesDir, { recursive: true });

  const template = localeTemplate(name, isView);

  const failedLangs = [];
  for (const lang of LANGUAGES) {
    try {
      fs.writeFileSync(`${localesDir}/${lang}.json`, template);
    } catch (err) {
      print.error(`Failed to write locale file for "${lang}": ${err.message}`);
      failedLangs.push(lang);
    }
  }

  if (failedLangs.length) {
    throw new Error(`Failed to generate locale file(s) for: ${failedLangs.join(', ')}`);
  }
  return filePaths;
}
