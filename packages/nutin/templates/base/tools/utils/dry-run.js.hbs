// --dry-run, for the scripts that take it.
// - npm reads "--dry-run" given without "--" as its own option.
// Without this check, "npm run generate ... --dry-run" would write.
// - runScript forwards env vars but not argv: a script it starts gets NUTIN_DRY_RUN.
export function isDryRun(argv = process.argv, env = process.env) {
  return argv.includes('--dry-run') || env.NUTIN_DRY_RUN === '1' || env.npm_config_dry_run === 'true';
}
