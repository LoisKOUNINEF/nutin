{
  "name": "nutin-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ws:version:patch": "npm run patch -w",
    "ws:version:minor": "npm run minor -w",
    "ws:version:major": "npm run major -w",
    "ws:build": "npm run build -w",
    "ws:build:prod": "npm run build:prod -w",
    "ws:serve": "npm run serve -w",
    "ws:serve:only": "npm run serve:only -w",
    "ws:dev": "npm run dev -w",
    "ws:generate": "npm run generate -w",
    "ws:watch": "npm run watch -w",
    "ws:testin-nutin": "npm run testin-nutin -w",
    "ws:testin-nutin:watch": "npm run testin-nutin:watch -w",
    "ws:testin-nutin:verbose": "npm run testin-nutin:verbose -w",
    "ws:testin-nutin:coverage": "npm run testin-nutin:coverage -w",
    "nutin:release": "npm run release -w @nutin/cli"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.1.1",
    "linkedom": "^0.18.13",
    "marked": "^18.0.14",
    "sass": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
